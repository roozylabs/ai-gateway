---
import Layout from '../layouts/Layout.astro';
import { 
	Shield, Route, ShieldCheck, Lock, Activity, Code,
	Menu, X, Github, BookOpen, Copy, ExternalLink, ArrowRight,
	SlidersHorizontal, CheckCircle2
} from 'lucide-react';

interface NavLink {
	label: string;
	href: string;
	external?: boolean;
}

const navLinks: NavLink[] = [
	{ label: 'Smart Routing', href: '#smart-routing' },
	{ label: 'Failover', href: '#failover' },
	{ label: 'Multi-Tenancy', href: '#governance' },
	{ label: 'Quickstart', href: '#quickstart' },
	{ label: 'Docs', href: 'https://docs.prism.roozylabs.com', external: true },
	{ label: 'GitHub', href: 'https://github.com/roozylabs/prism', external: true },
];

const benchmarkStats = [
	{ value: '1.96 ms', label: 'p95 Gateway Overhead', desc: 'Measured proxy processing latency' },
	{ value: '3,585 req/s', label: 'Single Node Throughput', desc: 'Tested at 500 concurrent workers' },
	{ value: '0 Data Races', label: 'Thread Safety', desc: 'go test -race verified across codebase' },
	{ value: '100% RLS', label: 'Tenant Isolation', desc: 'PostgreSQL Row-Level Security on all queries' },
];

const supportedProviders = [
	{ name: 'OpenAI', models: 'GPT-4o, o3-mini, o1', badge: 'v1/chat/completions' },
	{ name: 'Anthropic', models: 'Claude 3.7 Sonnet, 3.5 Haiku', badge: 'Messages API' },
	{ name: 'Google Gemini', models: 'Gemini 2.5 Flash, 2.5 Pro', badge: 'Native Adapter' },
	{ name: 'DeepSeek', models: 'DeepSeek R1, DeepSeek V3', badge: 'High-Throughput' },
	{ name: 'OpenRouter & Custom', models: 'Any OpenAI-compatible server', badge: 'Universal Proxy' },
];
---

<Layout title="RoozyLabs Prism - Universal AI Control Plane & Model Gateway">
	<!-- Background Ambient Refraction -->
	<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
		<div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[500px] bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,rgba(139,92,246,0.12),transparent_70%)]"></div>
	</div>

	<!-- Header Navigation -->
	<header class="sticky top-0 w-full z-50 bg-background/90 backdrop-blur-md border-b border-border/80">
		<div class="h-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
			<!-- Brand Mark (Shield Mark) -->
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-2.5 group">
					<div class="flex h-8 w-8 items-center justify-center rounded-none bg-[#7C3AED] text-white border border-violet-400/30 shadow-sm group-hover:bg-[#6D28D9] transition-colors">
						<Shield className="h-4 w-4" />
					</div>
					<div class="flex items-center gap-2">
						<span class="font-mono text-sm font-bold tracking-tight text-foreground">
							RoozyLabs <span class="text-primary">Prism</span>
						</span>
						<span class="font-mono text-[10px] text-muted-foreground bg-secondary px-1.5 py-0.5 rounded-none border border-border">
							v0.3.0
						</span>
					</div>
				</a>
			</div>
			
			<!-- Desktop Nav Links -->
			<nav class="hidden md:flex items-center gap-6 lg:gap-8">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						rel={link.external ? "noopener noreferrer" : undefined}
						class="text-xs text-muted-foreground hover:text-foreground transition-colors font-medium flex items-center gap-1"
					>
						{link.label}
						{link.external && <ExternalLink className="h-3 w-3 opacity-60" />}
					</a>
				))}
			</nav>

			<!-- Action CTA & Mobile Nav Toggle -->
			<div class="flex items-center gap-3">
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="hidden sm:inline-flex items-center justify-center h-8 px-3.5 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-none hover:bg-primary/90 transition-all shadow-sm"
				>
					Launch Console
				</a>

				<!-- Mobile Navigation Toggle -->
				<button 
					id="mobile-menu-btn"
					type="button"
					aria-label="Toggle Navigation Menu"
					aria-expanded="false"
					class="md:hidden h-8 px-2.5 rounded-none border border-border bg-card flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring cursor-pointer"
				>
					<span id="menu-icon-open"><Menu className="h-4 w-4" /></span>
					<span id="menu-icon-close" class="hidden"><X className="h-4 w-4" /></span>
					<span class="font-mono text-[11px]">Menu</span>
				</button>
			</div>
		</div>

		<!-- Mobile Navigation Drawer -->
		<div id="mobile-menu" class="hidden md:hidden border-b border-border bg-card/95 backdrop-blur-lg px-6 py-4 shadow-xl">
			<div class="flex flex-col gap-2 font-medium text-xs">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						rel={link.external ? "noopener noreferrer" : undefined}
						class="py-2 text-muted-foreground hover:text-foreground transition-colors border-b border-border/50 last:border-0 flex items-center justify-between"
					>
						<span>{link.label}</span>
						{link.external && <ExternalLink className="h-3.5 w-3.5 opacity-60" />}
					</a>
				))}
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="mt-3 w-full py-2.5 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-none text-center shadow-sm"
				>
					Launch Console
				</a>
			</div>
		</div>
	</header>

	<!-- Main Content Container -->
	<main class="w-full flex-1">
		
		<!-- Hero Section -->
		<section class="w-full pt-14 sm:pt-20 pb-14 sm:pb-16 px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
			<div class="max-w-4xl mx-auto flex flex-col items-center gap-5 sm:gap-6">
				
				<!-- Status Badge -->
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-none border border-border bg-card/90 text-xs font-mono shadow-sm">
					<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
					<span class="text-muted-foreground text-[11px]">Sub-2ms AI Gateway Engine • Active</span>
				</div>

				<!-- Hero Title -->
				<h1 class="font-bold text-3xl xs:text-4xl sm:text-5xl md:text-6xl leading-[1.1] sm:leading-[1.08] tracking-tight text-foreground max-w-4xl">
					One API endpoint for every LLM. <br class="hidden sm:inline" />
					<span class="text-primary">Zero downtime, automatic failover.</span>
				</h1>

				<!-- Hero Subtitle -->
				<p class="text-sm sm:text-base md:text-lg text-muted-foreground max-w-2xl leading-relaxed px-2">
					Route OpenAI, Anthropic, Gemini, and DeepSeek through a single drop-in proxy. Protect your application from rate limits, cut token costs automatically, and enforce organization budgets.
				</p>

				<!-- Action Buttons -->
				<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto mt-2">
					<a 
						href="https://app.prism.roozylabs.com/login" 
						class="h-10 px-6 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-none hover:bg-primary/90 transition-all shadow-[0_0_25px_rgba(139,92,246,0.3)] flex items-center justify-center gap-2"
					>
						<span>Launch Console</span>
						<ArrowRight className="h-3.5 w-3.5" />
					</a>
					<a 
						href="https://github.com/roozylabs/prism" 
						target="_blank" 
						rel="noopener noreferrer"
						class="h-10 px-6 bg-card text-foreground font-mono text-xs font-semibold rounded-none border border-border hover:bg-secondary transition-colors flex items-center justify-center gap-2 shadow-sm"
					>
						<Github className="h-4 w-4" /> View Source on GitHub
					</a>
				</div>

				<!-- Interactive Quickstart Console (SDK Switcher) -->
				<div id="quickstart" class="w-full max-w-3xl mt-8 rounded-none border border-border bg-console shadow-2xl text-left font-mono text-xs overflow-hidden">
					<!-- Console Header Bar -->
					<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-border/80 bg-console-header px-3 py-2 gap-2">
						<!-- Language Switcher Tabs -->
						<div class="flex items-center gap-1 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0" id="code-tabs">
							<button 
								type="button" 
								data-tab="opencode" 
								class="code-tab-btn px-2.5 py-1 text-[11px] rounded-none bg-primary/20 text-primary border border-primary/30 font-semibold cursor-pointer transition-all"
							>
								OpenCode CLI
							</button>
							<button 
								type="button" 
								data-tab="claude" 
								class="code-tab-btn px-2.5 py-1 text-[11px] rounded-none text-muted-foreground hover:text-foreground hover:bg-secondary font-medium cursor-pointer transition-all"
							>
								Claude Code
							</button>
							<button 
								type="button" 
								data-tab="python" 
								class="code-tab-btn px-2.5 py-1 text-[11px] rounded-none text-muted-foreground hover:text-foreground hover:bg-secondary font-medium cursor-pointer transition-all"
							>
								Python
							</button>
							<button 
								type="button" 
								data-tab="node" 
								class="code-tab-btn px-2.5 py-1 text-[11px] rounded-none text-muted-foreground hover:text-foreground hover:bg-secondary font-medium cursor-pointer transition-all"
							>
								TypeScript / Node
							</button>
							<button 
								type="button" 
								data-tab="curl" 
								class="code-tab-btn px-2.5 py-1 text-[11px] rounded-none text-muted-foreground hover:text-foreground hover:bg-secondary font-medium cursor-pointer transition-all"
							>
								cURL
							</button>
						</div>

						<!-- Copy Snippet Button -->
						<div class="flex items-center justify-between sm:justify-end gap-3 w-full sm:w-auto">
							<span class="text-[10px] text-emerald-400 font-mono flex items-center gap-1 shrink-0">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> api.prism.roozylabs.com
							</span>
							<button 
								id="copy-code-btn" 
								type="button"
								class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-none border border-border bg-console-card hover:bg-secondary text-[10px] text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
							>
								<Copy className="h-3 w-3" id="copy-icon" />
								<span id="copy-label">Copy</span>
							</button>
						</div>
					</div>

					<!-- Code Snippet Area -->
					<div class="p-4 overflow-x-auto">
						<!-- OpenCode CLI -->
						<pre id="snippet-opencode" class="code-snippet block text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-slate-500">// ~/.config/opencode/opencode.jsonc</span>
<span class="text-purple-400">&#123;</span>
  <span class="text-cyan-400">"provider"</span>: <span class="text-emerald-400">"prism"</span>,
  <span class="text-cyan-400">"api_url"</span>: <span class="text-emerald-400">"https://api.prism.roozylabs.com"</span>,
  <span class="text-cyan-400">"api_key"</span>: <span class="text-emerald-400">"gw_sk_live_85061cbfc18e4ca58e0e..."</span>,
  <span class="text-cyan-400">"model"</span>: <span class="text-purple-400">"prism-auto"</span>, <span class="text-slate-500">// Automatically routes prompt by complexity</span>
  <span class="text-cyan-400">"extra_headers"</span>: <span class="text-purple-400">&#123;</span>
    <span class="text-cyan-400">"X-Request-ID"</span>: <span class="text-emerald-400">"req_uuid_v4"</span>,
    <span class="text-cyan-400">"X-Prism-Agent-ID"</span>: <span class="text-emerald-400">"opencode-coding-agent"</span>
  <span class="text-purple-400">&#125;</span>
<span class="text-purple-400">&#125;</span></code></pre>

						<!-- Claude Code CLI -->
						<pre id="snippet-claude" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-slate-500"># Point Claude Code directly to your Prism AI Gateway</span>
<span class="text-purple-400">export</span> <span class="text-cyan-400">ANTHROPIC_BASE_URL</span>=<span class="text-emerald-400">"https://api.prism.roozylabs.com"</span>
<span class="text-purple-400">export</span> <span class="text-cyan-400">ANTHROPIC_API_KEY</span>=<span class="text-emerald-400">"gw_sk_live_85061cbfc18e4ca58e0e..."</span>

<span class="text-slate-500"># Run Claude with automatic rate-limit protection and budget monitoring</span>
claude</code></pre>

						<!-- Python SDK -->
						<pre id="snippet-python" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-purple-400">from</span> openai <span class="text-purple-400">import</span> OpenAI

<span class="text-slate-500"># Use standard OpenAI client pointing to Prism Gateway</span>
client = OpenAI(
    base_url=<span class="text-emerald-400">"https://api.prism.roozylabs.com/v1"</span>,
    api_key=<span class="text-emerald-400">"gw_sk_live_85061cbfc18e4ca58e0e..."</span>,
)

response = client.chat.completions.create(
    model=<span class="text-emerald-400">"prism-auto"</span>, <span class="text-slate-500"># or "claude-3-7-sonnet", "gpt-4o", "gemini-2.5-flash"</span>
    messages=[&#123;<span class="text-cyan-400">"role"</span>: <span class="text-emerald-400">"user"</span>, <span class="text-cyan-400">"content"</span>: <span class="text-emerald-400">"Analyze customer feedback trends."</span>&#125;]
)
print(response.choices[0].message.content)</code></pre>

						<!-- Node.js / TypeScript -->
						<pre id="snippet-node" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-purple-400">import</span> OpenAI <span class="text-purple-400">from</span> <span class="text-emerald-400">'openai'</span>;

<span class="text-purple-400">const</span> prism = <span class="text-purple-400">new</span> OpenAI(&#123;
  baseURL: <span class="text-emerald-400">'https://api.prism.roozylabs.com/v1'</span>,
  apiKey: <span class="text-emerald-400">'gw_sk_live_85061cbfc18e4ca58e0e...'</span>,
&#125;);

<span class="text-purple-400">const</span> completion = <span class="text-purple-400">await</span> prism.chat.completions.create(&#123;
  model: <span class="text-emerald-400">'prism-auto'</span>,
  messages: [&#123; role: <span class="text-emerald-400">'user'</span>, content: <span class="text-emerald-400">'Optimize database indexing strategy.'</span> &#125;],
&#125;);
console.log(completion.choices[0].message.content);</code></pre>

						<!-- cURL -->
						<pre id="snippet-curl" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code>curl -X POST https://api.prism.roozylabs.com/v1/chat/completions \
  -H <span class="text-emerald-400">"Authorization: Bearer gw_sk_live_85061cbfc18e4ca58e0e..."</span> \
  -H <span class="text-emerald-400">"Content-Type: application/json"</span> \
  -d <span class="text-emerald-400">'&#123;
    "model": "prism-auto",
    "messages": [&#123;"role": "user", "content": "Hello from cURL"&#125;]
  &#125;'</span></code></pre>
					</div>
				</div>
			</div>
		</section>

		<!-- Benchmark Stats Banner -->
		<section class="w-full py-8 sm:py-10 px-4 sm:px-6 lg:px-8 bg-card/60 border-y border-border">
			<div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
				{benchmarkStats.map((stat) => (
					<div class="p-5 bg-background border border-border rounded-none shadow-sm flex flex-col items-center text-center">
						<span class="font-mono font-bold text-2xl sm:text-3xl text-primary">{stat.value}</span>
						<span class="font-semibold text-xs sm:text-sm text-foreground mt-1">{stat.label}</span>
						<span class="font-mono text-[11px] text-muted-foreground mt-1">{stat.desc}</span>
					</div>
				))}
			</div>
		</section>

		<!-- Feature Section 1: Smart Routing -->
		<section id="smart-routing" class="w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-background">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
				<!-- Left Text -->
				<div class="lg:col-span-5 flex flex-col gap-4">
					<div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-none bg-primary/10 border border-primary/20 text-primary font-mono text-[11px] font-semibold w-fit">
						<Route className="h-3.5 w-3.5" /> SMART MODEL ROUTING
					</div>
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-foreground">
						Cut token bills up to 70% without sacrificing quality.
					</h2>
					<p class="text-sm text-muted-foreground leading-relaxed">
						Not every prompt needs a costly frontier model. When you specify <code class="text-primary font-mono bg-card px-1.5 py-0.5 rounded-none border border-border">model: "prism-auto"</code>, Prism dynamically scores candidate models based on task complexity, required context window, and your policy rules.
					</p>
					
					<ul class="space-y-2.5 text-xs text-muted-foreground mt-2">
						<li class="flex items-start gap-2">
							<CheckCircle2 className="h-4 w-4 text-emerald-400 shrink-0 mt-0.5" />
							<span><strong>Simple queries</strong> route to lightweight models like GPT-4o-mini or Claude 3.5 Haiku ($0.15–$0.25/1M tokens).</span>
						</li>
						<li class="flex items-start gap-2">
							<CheckCircle2 className="h-4 w-4 text-emerald-400 shrink-0 mt-0.5" />
							<span><strong>Deep reasoning & code</strong> route to flagship models like Claude 3.7 Sonnet or DeepSeek R1.</span>
						</li>
						<li class="flex items-start gap-2">
							<CheckCircle2 className="h-4 w-4 text-emerald-400 shrink-0 mt-0.5" />
							<span><strong>Pre-filtering</strong> ensures requests only go to providers where you have active credentials and quota.</span>
						</li>
					</ul>
				</div>

				<!-- Right Interactive Policy Demo -->
				<div class="lg:col-span-7 bg-card border border-border rounded-none p-5 sm:p-6 shadow-xl">
					<div class="flex items-center justify-between border-b border-border pb-3 mb-4">
						<span class="font-mono text-xs font-semibold text-foreground flex items-center gap-2">
							<SlidersHorizontal className="h-4 w-4 text-primary" /> Routing Policy Simulator
						</span>
						<span class="text-[11px] font-mono text-emerald-400">Live Decision Engine</span>
					</div>

					<!-- Policy Selector Buttons -->
					<div class="grid grid-cols-3 gap-2 mb-4" id="policy-buttons">
						<button 
							type="button" 
							data-policy="balanced" 
							class="policy-btn px-3 py-2 rounded-none bg-primary/20 text-primary border border-primary/40 font-mono text-xs font-semibold text-center cursor-pointer transition-all"
						>
							Balanced Policy
						</button>
						<button 
							type="button" 
							data-policy="cheap" 
							class="policy-btn px-3 py-2 rounded-none bg-background text-muted-foreground border border-border font-mono text-xs font-medium text-center hover:text-foreground cursor-pointer transition-all"
						>
							Lowest Cost
						</button>
						<button 
							type="button" 
							data-policy="quality" 
							class="policy-btn px-3 py-2 rounded-none bg-background text-muted-foreground border border-border font-mono text-xs font-medium text-center hover:text-foreground cursor-pointer transition-all"
						>
							Max Quality
						</button>
					</div>

					<!-- Route Evaluation Box -->
					<div class="p-4 rounded-none bg-console border border-border font-mono text-xs space-y-3">
						<div class="flex justify-between items-center text-[11px] text-muted-foreground border-b border-border/70 pb-2">
							<span>Prompt: <span class="text-slate-300">"Summarize this 10-line customer feedback."</span></span>
							<span class="text-cyan-400">Context: 420 tokens</span>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
							<div class="p-2.5 rounded-none bg-card/80 border border-border">
								<span class="text-[10px] text-muted-foreground block">Selected Target Model</span>
								<span id="route-model" class="text-emerald-400 font-bold text-sm block mt-0.5">GPT-4o-mini</span>
							</div>
							<div class="p-2.5 rounded-none bg-card/80 border border-border">
								<span class="text-[10px] text-muted-foreground block">Estimated Cost</span>
								<span id="route-cost" class="text-primary font-bold text-sm block mt-0.5">$0.000063</span>
							</div>
							<div class="p-2.5 rounded-none bg-card/80 border border-border">
								<span class="text-[10px] text-muted-foreground block">Expected Latency</span>
								<span id="route-latency" class="text-slate-200 font-bold text-sm block mt-0.5">~195 ms</span>
							</div>
						</div>

						<p id="route-explanation" class="text-[11px] text-slate-400 pt-1 leading-relaxed">
							Task classified as low complexity summarization. Balanced policy selected GPT-4o-mini for maximum speed and 90% cost savings over flagship models.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Feature Section 2: Failure Resilience & Circuit Breakers -->
		<section id="failover" class="w-full py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-card/40 border-t border-border">
			<div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
				<!-- Left Interactive Circuit Breaker Visual -->
				<div class="lg:col-span-7 bg-console border border-border rounded-none p-5 sm:p-6 shadow-xl font-mono text-xs">
					<div class="flex items-center justify-between border-b border-border/80 pb-3 mb-4">
						<span class="text-xs text-foreground font-semibold flex items-center gap-2">
							<ShieldCheck className="h-4 w-4 text-emerald-400" /> Automatic Failover & Circuit Quarantine
						</span>
						<span class="text-[10px] text-emerald-400">$0.00 Retry Billing</span>
					</div>

					<div class="space-y-3.5">
						<!-- Step 1: Upstream error -->
						<div class="p-3 rounded-none border border-red-500/30 bg-red-500/5 flex items-center justify-between">
							<div class="flex items-center gap-2.5">
