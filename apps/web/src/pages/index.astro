---
import Layout from '../layouts/Layout.astro';

interface NavLink {
	label: string;
	href: string;
	external?: boolean;
}

const navLinks: NavLink[] = [
	{ label: 'Documentation', href: 'https://docs.prism.roozylabs.com', external: true },
	{ label: 'Architecture', href: '#architecture' },
	{ label: 'GitHub', href: 'https://github.com/roozylabs/prism', external: true },
	{ label: 'Changelog', href: '#changelog' },
];

const problemWithoutPrism: string[] = [
	'Hardcoded API keys everywhere',
	'Brittle failovers and retries',
	'Blind spots in token usage',
	'Vendor lock-in',
];

const solutionWithPrism: string[] = [
	'Single unified endpoint',
	'Intelligent smart routing',
	'Granular FinOps dashboards',
	'Agnostic model switching',
];

interface FeatureCard {
	icon: string;
	title: string;
	description: string;
}

const featureCards: FeatureCard[] = [
	{
		icon: 'route',
		title: 'Smart Routing',
		description: 'Automatically route requests based on cost, latency, or performance metrics.',
	},
	{
		icon: 'health_and_safety',
		title: 'Reliability',
		description: 'Zero-downtime failovers and automatic retries across providers.',
	},
	{
		icon: 'query_stats',
		title: 'Observability',
		description: 'Deep insights into token usage, latency, and agent behavior.',
	},
];
---

<Layout title="RoozyLabs Prism - One Control Plane for Your Entire AI Stack">
	<!-- Header -->
	<header class="fixed top-0 w-full z-50 bg-[#08090a]/80 backdrop-blur-xl border-b border-[#222222]/50">
		<div class="h-16 max-w-7xl mx-auto px-6 flex items-center justify-between gap-4">
			<div class="flex items-center gap-2">
				<a href="/" class="flex items-center gap-2">
					<div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#8B5CF6] to-indigo-500 flex items-center justify-center font-bold text-white text-base shadow-[0_0_15px_rgba(139,92,246,0.3)]">
						P
					</div>
					<span class="font-semibold text-lg text-slate-100 tracking-tight">RoozyLabs Prism</span>
				</a>
			</div>
			
			<nav class="hidden md:flex items-center gap-8">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						class="text-sm text-[#cbc3d7] hover:text-[#e3e2e3] transition-colors font-medium"
					>
						{link.label}
					</a>
				))}
			</nav>

			<div class="flex items-center gap-4">
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="hidden sm:flex items-center justify-center px-4 py-2 bg-[#8B5CF6]/10 text-[#8B5CF6] border border-[#8B5CF6]/20 font-mono text-xs font-semibold rounded-lg hover:bg-[#8B5CF6] hover:text-white transition-colors"
				>
					GET STARTED
				</a>
			</div>
		</div>
	</header>

	<!-- Main Content -->
	<main class="w-full pt-16">
		<div class="flex flex-col w-full relative z-0">
			<!-- Background Glow & Grid Overlay -->
			<div class="absolute inset-0 z-[-1] pointer-events-none opacity-[0.15]" style="background-image: radial-gradient(circle at 50% 0%, #8B5CF6 0%, transparent 40%);"></div>
			<div class="absolute inset-0 z-[-1] pointer-events-none opacity-[0.05]" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E'); background-size: 30px 30px;"></div>

			<!-- Hero Section -->
			<section class="w-full min-h-[700px] flex flex-col items-center justify-center pt-32 pb-24 px-6 relative overflow-hidden">
				<div class="max-w-4xl mx-auto text-center relative z-10 flex flex-col items-center gap-8">
					<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#8B5CF6]/30 bg-[#8B5CF6]/10">
						<span class="w-2 h-2 rounded-full bg-[#8B5CF6] shadow-[0_0_8px_#8B5CF6]"></span>
						<span class="font-mono text-[#8B5CF6] uppercase tracking-widest text-[10px]">RoozyLabs Prism</span>
					</div>

					<h1 class="font-semibold text-[48px] md:text-[72px] leading-[1.05] tracking-tight text-[#e3e2e3] max-w-3xl">
						One Control Plane for Your Entire <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8B5CF6] to-blue-400">AI Stack</span>.
					</h1>

					<p class="text-[20px] text-[#cbc3d7] max-w-2xl leading-relaxed">
						Unify models, tools, resources, and agents behind one intelligent infrastructure layer.
					</p>

					<div class="flex flex-col sm:flex-row items-center gap-4 mt-4">
						<a 
							href="https://app.prism.roozylabs.com/login" 
							class="h-12 px-8 bg-[#8B5CF6] text-white font-mono text-xs font-semibold rounded-lg hover:bg-[#8B5CF6]/80 transition-colors shadow-[0_0_20px_rgba(139,92,246,0.3)] flex items-center justify-center"
						>
							GET STARTED
						</a>
						<a 
							href="https://github.com/roozylabs/prism" 
							target="_blank" 
							class="h-12 px-8 bg-[#121315] text-[#e3e2e3] font-mono text-xs font-semibold rounded-lg border border-[#222222] hover:bg-[#1a1b1d] transition-colors flex items-center justify-center"
						>
							VIEW GITHUB
						</a>
					</div>

					<div class="flex flex-wrap justify-center gap-6 mt-8 opacity-60">
						<div class="flex items-center gap-2">
							<span class="material-symbols-outlined text-[16px]">check_circle</span>
							<span class="font-mono text-[13px]">Open Source</span>
						</div>
						<div class="flex items-center gap-2">
							<span class="material-symbols-outlined text-[16px]">check_circle</span>
							<span class="font-mono text-[13px]">Multi-Provider</span>
						</div>
						<div class="flex items-center gap-2">
							<span class="material-symbols-outlined text-[16px]">check_circle</span>
							<span class="font-mono text-[13px]">Agent Ready</span>
						</div>
						<div class="flex items-center gap-2">
							<span class="material-symbols-outlined text-[16px]">check_circle</span>
							<span class="font-mono text-[13px]">Production Ready</span>
						</div>
					</div>
				</div>
			</section>

			<!-- The Problem (The Complexity Crisis) -->
			<section class="w-full py-24 px-6 bg-[#0c0d0f] border-y border-[#222222]/30">
				<div class="max-w-7xl mx-auto flex flex-col gap-12">
					<div class="text-center">
						<h2 class="text-3xl font-semibold text-white mb-4">The Complexity Crisis</h2>
						<p class="text-[#cbc3d7] max-w-2xl mx-auto">Managing multiple AI models and agents leads to fragmented infrastructure, unpredictable costs, and reliability nightmares.</p>
					</div>

					<div class="grid md:grid-cols-2 gap-8">
						<!-- Without Prism -->
						<div class="bg-[#08090a] border border-[#222222]/50 rounded-xl p-8 shadow-lg">
							<h3 class="text-[#ffb4ab] font-medium mb-4 flex items-center gap-2">
								<span class="material-symbols-outlined">close</span> Without Prism
							</h3>
							<ul class="space-y-4 text-[#cbc3d7] font-mono text-sm">
								{problemWithoutPrism.map((item) => (
									<li class="flex items-start gap-2">
										<span class="text-[#ffb4ab] mt-0.5">-</span> {item}
									</li>
								))}
							</ul>
						</div>

						<!-- With Prism -->
						<div class="bg-[#08090a] border border-[#8B5CF6]/30 rounded-xl p-8 shadow-[0_0_30px_rgba(139,92,246,0.05)] relative overflow-hidden">
							<div class="absolute inset-0 bg-gradient-to-br from-[#8B5CF6]/5 to-transparent"></div>
							<h3 class="text-[#8B5CF6] font-medium mb-4 flex items-center gap-2 relative z-10">
								<span class="material-symbols-outlined">check</span> With Prism
							</h3>
							<ul class="space-y-4 text-[#cbc3d7] font-mono text-sm relative z-10">
								{solutionWithPrism.map((item) => (
									<li class="flex items-start gap-2">
										<span class="text-[#8B5CF6] mt-0.5">+</span> {item}
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- Core Value Section -->
			<section class="w-full py-24 px-6">
				<div class="max-w-7xl mx-auto">
					<div class="text-center mb-16">
						<h2 class="text-3xl font-semibold text-white mb-4">Enterprise-Grade Infrastructure</h2>
						<p class="text-[#cbc3d7] max-w-2xl mx-auto">Everything you need to run AI at scale, built into a single unified plane.</p>
					</div>

					<div class="grid md:grid-cols-3 gap-6">
						{featureCards.map((card) => (
							<div class="p-6 border border-[#222222]/30 rounded-xl bg-[#121315] hover:border-[#8B5CF6]/50 transition-colors">
								<span class="material-symbols-outlined text-[#8B5CF6] mb-4 text-3xl">{card.icon}</span>
								<h3 class="text-lg font-semibold text-white mb-2">{card.title}</h3>
								<p class="text-[#cbc3d7] text-sm leading-relaxed">{card.description}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Final CTA Section -->
			<section class="w-full py-32 px-6 relative overflow-hidden bg-[#08090a] border-t border-[#222222]/20">
				<div class="absolute inset-0 bg-[#8B5CF6]/5 pointer-events-none"></div>
				<div class="max-w-4xl mx-auto text-center relative z-10 flex flex-col items-center">
					<div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#8B5CF6] to-pink-500 flex items-center justify-center font-bold text-white text-3xl mb-8 shadow-xl shadow-[#8B5CF6]/20">
						P
					</div>
					<h2 class="text-4xl md:text-5xl font-semibold text-white mb-6">Ready to unify your AI stack?</h2>
					<p class="text-[#cbc3d7] text-lg mb-10 max-w-2xl">Join forward-thinking teams building the next generation of reliable, scalable AI applications.</p>
					<div class="flex gap-4">
						<a 
							href="https://app.prism.roozylabs.com/login" 
							class="h-12 px-8 bg-[#8B5CF6] text-white font-mono text-xs font-semibold rounded-lg hover:bg-[#8B5CF6]/80 transition-colors flex items-center justify-center shadow-lg shadow-[#8B5CF6]/20"
						>
							START BUILDING FREE
						</a>
						<a 
							href="https://docs.prism.roozylabs.com" 
							target="_blank"
							class="h-12 px-8 bg-[#08090a] text-[#e3e2e3] font-mono text-xs font-semibold rounded-lg border border-[#222222] hover:bg-[#121315] transition-colors flex items-center justify-center"
						>
							READ DOCS
						</a>
					</div>
				</div>
			</section>
		</div>
	</main>

	<!-- Footer -->
	<footer class="w-full bg-[#08090a] border-t border-[#222222]/20 py-8">
		<div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-5 gap-8">
			<div class="col-span-2">
				<div class="flex items-center gap-2 mb-4">
					<div class="w-6 h-6 rounded bg-[#8B5CF6] flex items-center justify-center font-bold text-white text-xs">P</div>
					<span class="font-semibold text-slate-200">RoozyLabs Prism</span>
				</div>
				<p class="text-[#cbc3d7] text-sm max-w-xs leading-relaxed">The infrastructure-as-code visualization and governance layer for modern AI teams.</p>
			</div>

			<div>
				<h4 class="font-mono text-xs text-white mb-4 uppercase tracking-widest">Product</h4>
				<ul class="space-y-2 text-sm text-[#cbc3d7]">
					<li><a href="#" class="hover:text-[#8B5CF6] transition-colors">Prism Engine</a></li>
					<li><a href="#features" class="hover:text-[#8B5CF6] transition-colors">Features</a></li>
					<li><a href="#" class="hover:text-[#8B5CF6] transition-colors">Roadmap</a></li>
				</ul>
			</div>

			<div>
				<h4 class="font-mono text-xs text-white mb-4 uppercase tracking-widest">Resources</h4>
				<ul class="space-y-2 text-sm text-[#cbc3d7]">
					<li><a href="https://docs.prism.roozylabs.com" target="_blank" class="hover:text-[#8B5CF6] transition-colors">Docs</a></li>
					<li><a href="https://api.prism.roozylabs.com/health" target="_blank" class="hover:text-[#8B5CF6] transition-colors">API Status</a></li>
					<li><a href="#" class="hover:text-[#8B5CF6] transition-colors">SDKs</a></li>
				</ul>
			</div>

			<div>
				<h4 class="font-mono text-xs text-white mb-4 uppercase tracking-widest">Community</h4>
				<ul class="space-y-2 text-sm text-[#cbc3d7]">
					<li><a href="https://github.com/roozylabs/prism" target="_blank" class="hover:text-[#8B5CF6] transition-colors">GitHub</a></li>
					<li><a href="#" class="hover:text-[#8B5CF6] transition-colors">Discord</a></li>
					<li><a href="#" class="hover:text-[#8B5CF6] transition-colors">Twitter</a></li>
				</ul>
			</div>
		</div>

		<div class="max-w-7xl mx-auto px-6 mt-8 pt-6 border-t border-[#222222]/10 text-center text-[#cbc3d7]/40 font-mono text-xs">
			&copy; 2026 RoozyLabs. All rights reserved.
		</div>
	</footer>
</Layout>
