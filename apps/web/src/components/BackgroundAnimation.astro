---
// Dynamic AI Gateway & Telemetry Matrix Background Animation
// Includes ambient prism refraction, active data packet routing streams, and subtle micro-glitches
---

<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
	<!-- 1. Radial Vignette Darkening / Softening Mask -->
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_85%_65%_at_50%_15%,transparent_35%,hsl(var(--background))_100%)]"></div>

	<!-- 2. High-Tech Data Telemetry & Glitch Canvas -->
	<canvas id="bg-canvas" class="absolute inset-0 w-full h-full"></canvas>
</div>

<script>
	interface DataPacket {
		x: number;
		y: number;
		axis: 'x' | 'y';
		dir: 1 | -1;
		speed: number;
		length: number;
		color: string;
		opacity: number;
	}

	interface GlitchSlice {
		y: number;
		height: number;
		offset: number;
		life: number;
		maxLife: number;
		color: string;
	}

	function initBackground() {
		const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
		if (!canvas) return;

		const ctx = canvas.getContext('2d', { alpha: true });
		if (!ctx) return;

		let animationFrameId: number;
		let width = (canvas.width = window.innerWidth);
		let height = (canvas.height = window.innerHeight);

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let phase = 0;
		const gridSize = 56;

		// Active data routing packet pulses
		const packetColorsDark = [
			'rgba(139, 92, 246, ', // Prism Violet
			'rgba(6, 182, 212, ',  // Cyan
			'rgba(16, 185, 129, ', // Emerald
			'rgba(168, 85, 247, ', // Purple
		];

		const packetColorsLight = [
			'rgba(124, 58, 237, ', // Darker Violet
			'rgba(2, 132, 199, ',  // Blue
			'rgba(5, 150, 105, ',  // Dark Emerald
		];

		const packets: DataPacket[] = [];
		const maxPackets = 16;

		function spawnPacket(isDark: boolean): DataPacket {
			const colors = isDark ? packetColorsDark : packetColorsLight;
			const axis: 'x' | 'y' = Math.random() > 0.5 ? 'x' : 'y';
			const startX = (width % gridSize) / 2;
			const startY = (height % gridSize) / 2;

			let x = 0;
			let y = 0;

			if (axis === 'x') {
				const colIndex = Math.floor(Math.random() * ((height - startY) / gridSize));
				y = startY + colIndex * gridSize;
				x = Math.random() > 0.5 ? 0 : width;
			} else {
				const rowIndex = Math.floor(Math.random() * ((width - startX) / gridSize));
				x = startX + rowIndex * gridSize;
				y = Math.random() > 0.5 ? 0 : height;
			}

			return {
				x,
				y,
				axis,
				dir: Math.random() > 0.5 ? 1 : -1,
				speed: 0.8 + Math.random() * 1.6,
				length: 24 + Math.random() * 40,
				color: colors[Math.floor(Math.random() * colors.length)],
				opacity: 0.2 + Math.random() * 0.45,
			};
		}

		for (let i = 0; i < maxPackets; i++) {
			packets.push(spawnPacket(document.documentElement.classList.contains('dark')));
		}

		// Micro-glitch slice states
		let glitchSlices: GlitchSlice[] = [];
		let nextGlitchFrame = 60 + Math.floor(Math.random() * 100);
		let frameCount = 0;

		const handleResize = () => {
			if (!canvas) return;
			width = canvas.width = window.innerWidth;
			height = canvas.height = window.innerHeight;
		};

		window.addEventListener('resize', handleResize);

		const render = () => {
			const isDark = document.documentElement.classList.contains('dark');
			ctx.clearRect(0, 0, width, height);

			if (!prefersReducedMotion) {
				phase += 0.005;
				frameCount++;
			}

			// 1. Ambient Top-Center Prism Refraction (Soft Glow)
			const centerX = width / 2;
			const topY = height * 0.12;
			const radius = Math.max(width, height) * 0.55;

			const radialGrad = ctx.createRadialGradient(
				centerX + Math.sin(phase) * 45,
				topY + Math.cos(phase * 0.7) * 20,
				0,
				centerX,
				topY,
				radius
			);

			if (isDark) {
				radialGrad.addColorStop(0, 'rgba(139, 92, 246, 0.13)');
				radialGrad.addColorStop(0.35, 'rgba(6, 182, 212, 0.04)');
				radialGrad.addColorStop(0.7, 'rgba(124, 58, 237, 0.015)');
				radialGrad.addColorStop(1, 'rgba(8, 9, 10, 0)');
			} else {
				radialGrad.addColorStop(0, 'rgba(124, 58, 237, 0.07)');
				radialGrad.addColorStop(0.35, 'rgba(2, 132, 199, 0.025)');
				radialGrad.addColorStop(0.7, 'rgba(139, 92, 246, 0.01)');
				radialGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
			}

			ctx.fillStyle = radialGrad;
			ctx.fillRect(0, 0, width, height);

			// 2. Geometric Coordinate Grid Lines & Crosshairs
			const startX = (width % gridSize) / 2;
			const startY = (height % gridSize) / 2;

			ctx.lineWidth = 1;
			ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.026)' : 'rgba(0, 0, 0, 0.038)';

			ctx.beginPath();
			for (let x = startX; x <= width; x += gridSize) {
				ctx.moveTo(x, 0);
				ctx.lineTo(x, height);
			}
			for (let y = startY; y <= height; y += gridSize) {
				ctx.moveTo(0, y);
				ctx.lineTo(width, y);
			}
			ctx.stroke();

			// 3. Grid Intersection Crosshairs (+)
			ctx.strokeStyle = isDark ? 'rgba(139, 92, 246, 0.08)' : 'rgba(124, 58, 237, 0.06)';
			ctx.beginPath();
			const crossLen = 3;
			for (let x = startX; x <= width; x += gridSize * 2) {
				for (let y = startY; y <= height; y += gridSize * 2) {
					ctx.moveTo(x - crossLen, y);
					ctx.lineTo(x + crossLen, y);
					ctx.moveTo(x, y - crossLen);
					ctx.lineTo(x, y + crossLen);
				}
			}
			ctx.stroke();

			// 4. Active Data Packet Pulses (Moving Tokens across Grid)
			if (!prefersReducedMotion) {
				packets.forEach((p, idx) => {
					if (p.axis === 'x') {
						p.x += p.speed * p.dir;
						if (p.x > width + p.length || p.x < -p.length) {
							packets[idx] = spawnPacket(isDark);
							return;
						}

						const grad = ctx.createLinearGradient(
							p.x - p.length * p.dir, p.y,
							p.x, p.y
						);
						grad.addColorStop(0, `${p.color}0)`);
						grad.addColorStop(1, `${p.color}${p.opacity})`);

						ctx.strokeStyle = grad;
						ctx.lineWidth = 1.5;
						ctx.beginPath();
						ctx.moveTo(p.x - p.length * p.dir, p.y);
						ctx.lineTo(p.x, p.y);
						ctx.stroke();

						// Glowing head dot
						ctx.fillStyle = `${p.color}${p.opacity + 0.2})`;
						ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
					} else {
						p.y += p.speed * p.dir;
						if (p.y > height + p.length || p.y < -p.length) {
							packets[idx] = spawnPacket(isDark);
							return;
						}

						const grad = ctx.createLinearGradient(
							p.x, p.y - p.length * p.dir,
							p.x, p.y
						);
						grad.addColorStop(0, `${p.color}0)`);
						grad.addColorStop(1, `${p.color}${p.opacity})`);

						ctx.strokeStyle = grad;
						ctx.lineWidth = 1.5;
						ctx.beginPath();
						ctx.moveTo(p.x, p.y - p.length * p.dir);
						ctx.lineTo(p.x, p.y);
						ctx.stroke();

						// Glowing head dot
						ctx.fillStyle = `${p.color}${p.opacity + 0.2})`;
						ctx.fillRect(p.x - 1, p.y - 1, 2, 2);
					}
				});
			}

			// 5. Subtle Digital Telemetry Micro-Glitch Slices (Occasional, Soft & Non-Intrusive)
			if (!prefersReducedMotion) {
				if (frameCount >= nextGlitchFrame) {
					// Spawn 1-3 tiny horizontal glitch artifacts
					const sliceCount = 1 + Math.floor(Math.random() * 2);
					for (let s = 0; s < sliceCount; s++) {
						glitchSlices.push({
							y: Math.random() * height,
							height: 2 + Math.random() * 6,
							offset: (Math.random() - 0.5) * 16,
							life: 0,
							maxLife: 4 + Math.floor(Math.random() * 6), // Lasts only ~4-8 frames (60-120ms)
							color: Math.random() > 0.5 ? 'rgba(6, 182, 212, ' : 'rgba(139, 92, 246, ',
						});
					}
					nextGlitchFrame = frameCount + 120 + Math.floor(Math.random() * 180); // Triggers every 2-5 seconds
				}

				// Render & update glitch slices
				glitchSlices = glitchSlices.filter((slice) => {
					slice.life++;
					const progress = slice.life / slice.maxLife;
					const alpha = Math.sin(progress * Math.PI) * (isDark ? 0.07 : 0.04);

					ctx.fillStyle = `${slice.color}${alpha})`;
					ctx.fillRect(0, slice.y, width, slice.height);

					// Occasional micro-shifted segment
					if (Math.random() > 0.3) {
						const segX = Math.random() * (width - 150);
						const segW = 60 + Math.random() * 140;
						ctx.fillStyle = isDark ? `rgba(255, 255, 255, ${alpha * 1.5})` : `rgba(0, 0, 0, ${alpha * 1.2})`;
						ctx.fillRect(segX + slice.offset, slice.y, segW, slice.height);
					}

					return slice.life < slice.maxLife;
				});
			}

			animationFrameId = requestAnimationFrame(render);
		};

		render();
	}

	// Initialize on page load and astro page swaps
	initBackground();
	document.addEventListener('astro:page-load', initBackground);
</script>
