---
import Layout from '../layouts/Layout.astro';

interface NavLink {
	label: string;
	href: string;
	external?: boolean;
}

const navLinks: NavLink[] = [
	{ label: 'Pillars', href: '#pillars' },
	{ label: 'Architecture', href: '#architecture' },
	{ label: 'Client Integration', href: '#integration' },
	{ label: 'Docs', href: 'https://docs.prism.roozylabs.com', external: true },
	{ label: 'GitHub', href: 'https://github.com/roozylabs/prism', external: true },
];

const clientEcosystem = [
	{ name: 'OpenCode CLI', icon: 'terminal', type: 'AI Coding Assistant' },
	{ name: 'Claude Code', icon: 'code_blocks', type: 'Anthropic CLI Agent' },
	{ name: 'Antigravity IDE', icon: 'smart_toy', type: 'AI Pair Programmer' },
	{ name: 'LangChain / LlamaIndex', icon: 'hub', type: 'Agent Frameworks' },
	{ name: 'Custom AI Apps', icon: 'api', type: 'REST & SSE SDKs' },
];

const supportedProviders = [
	{ name: 'OpenAI', models: 'GPT-4o, o3-mini' },
	{ name: 'Anthropic', models: 'Claude 3.5 Sonnet, 3.7 Sonnet' },
	{ name: 'Google Gemini', models: 'Gemini 2.0 Flash, 1.5 Pro' },
	{ name: 'OpenRouter', models: '200+ Open Models' },
	{ name: 'OpenCode Free', models: 'Kimi, DeepSeek R1, Qwen 2.5' },
];

interface Pillar {
	id: number;
	icon: string;
	title: string;
	tagline: string;
	description: string;
	highlights: string[];
}

const pillars: Pillar[] = [
	{
		id: 1,
		icon: 'power',
		title: 'Universal Model Gateway',
		tagline: 'Single OpenAI-Compatible Proxy Engine',
		description: 'Unify OpenAI, Anthropic, Google Gemini, OpenRouter, and OpenCode through a single API key with zero-latency streaming pass-through.',
		highlights: ['/v1/chat/completions', '/v1/models', 'Pass-Through SSE Streaming'],
	},
	{
		id: 2,
		icon: 'route',
		title: 'Prism Auto Smart Router',
		tagline: 'prism-auto Prompt Classification Engine',
		description: 'Deterministic task complexity & context window analysis with pre-filtered candidate scoring across balanced, cheap, or quality policies.',
		highlights: ['Dynamic Candidate Scoring', 'Credential Pre-Filtering', 'Policy Presets'],
	},
	{
		id: 3,
		icon: 'account_balance_wallet',
		title: 'FinOps & Cost Analytics',
		tagline: 'Real-time Token Cost & Budget Manager',
		description: '6-dimensional token cost tracking, daily/monthly spend limits, velocity alert thresholds, and burn-rate forecasting.',
		highlights: ['CostUSD Calculation', 'Burn Rate Forecast', 'Velocity Alerts'],
	},
	{
		id: 4,
		icon: 'health_and_safety',
		title: 'Quarantine & Circuit Breaker',
		tagline: 'Zero-Downtime Failover Cascade',
		description: 'Automatic 50x error detection, 60-second credential cooldown quarantine, and instant fallback model substitution.',
		highlights: ['50x Error Detection', '60s Cooldown Vault', 'Zero-Downtime Fallback'],
	},
	{
		id: 5,
		icon: 'vpn_key',
		title: 'AES-256-GCM Vault & Rotation',
		tagline: 'Dynamic Credential Allocation Pool',
		description: 'Encrypted key vault supporting Round Robin, LRU, and Fallback Cascade rotation strategies with Google OAuth token exchange.',
		highlights: ['AES-256-GCM Encryption', 'Google OAuth Refresh Flow', 'LRU & Round Robin'],
	},
	{
		id: 6,
		icon: 'construction',
		title: 'Tool Gateway Control Plane',
		tagline: 'Centralized Function Calling Hub',
		description: 'Register external REST API tools and custom functions with header injection, priority failovers, and interactive sandbox execution.',
		highlights: ['REST API Tool Hub', 'Priority Failover Routing', 'Sandbox Testing'],
	},
	{
		id: 7,
		icon: 'database',
		title: 'Resource Gateway Engine',
		tagline: 'Dynamic SQL & REST Data Layer',
		description: 'Dynamic data fetching layer connecting REST API endpoints and direct PostgreSQL querying with parameterized SQL templates.',
		highlights: ['Parameterized SQL Engine', 'REST Data Gateway', 'PostgreSQL Direct Pool'],
	},
	{
		id: 8,
		icon: 'extension',
		title: 'MCP Protocol Gateway',
		tagline: 'Model Context Protocol Integrator',
		description: 'Connect HTTP and SSE Model Context Protocol servers (GitHub, Notion, Custom Agents) with automatic JSON-RPC 2.0 discovery.',
		highlights: ['JSON-RPC 2.0 Discovery', 'GitHub & Notion MCP', 'SSE Protocol Pass-Through'],
	},
	{
		id: 9,
		icon: 'smart_toy',
		title: 'Agent Infrastructure & Hub',
		tagline: 'Autonomous AI Agent Governance',
		description: 'Identify and govern AI agents (X-Prism-Agent-ID) with granular permitted model lists, tool boundaries, and budget caps.',
		highlights: ['X-Prism-Agent-ID Telemetry', 'Agent Budget Boundaries', 'Tool Access Whitelists'],
	},
	{
		id: 10,
		icon: 'gavel',
		title: 'Declarative Policy & RBAC Engine',
		tagline: 'DENY Precedence Governance System',
		description: 'Enterprise RBAC policy engine enforcing strict wildcard matching rules, role bindings, and absolute DENY precedence.',
		highlights: ['DENY Precedence', 'Wildcard Policy Rules', 'Cross-Domain RBAC'],
	},
	{
		id: 11,
		icon: 'verified_user',
		title: 'Cryptographic AI Audit Trail',
		tagline: 'SHA-256 Tamper-Proof Execution Log',
		description: '6-dimensional audit trail capturing WHO, REQUEST, MODEL, TOOLS/RESOURCES, COST, and OUTCOME with SHA-256 signature verification.',
		highlights: ['SHA-256 Signatures', '6D Telemetry Logging', 'Tamper-Proof Audit Vault'],
	},
];
---

<Layout title="Prism - Universal AI Control Plane & Model Gateway">
	<!-- Header Navigation -->
	<header class="fixed top-0 w-full z-50 bg-[#08090a]/90 backdrop-blur-xl border-b border-[#222222]/60">
		<div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-4">
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-2.5">
					<div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#8B5CF6] via-indigo-500 to-purple-600 flex items-center justify-center font-bold text-white text-base shadow-[0_0_20px_rgba(139,92,246,0.4)]">
						💎
					</div>
					<span class="font-bold text-lg text-slate-100 tracking-tight">Prism</span>
				</a>
			</div>
			
			<!-- Desktop Nav Links -->
			<nav class="hidden md:flex items-center gap-6 lg:gap-8">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						class="text-sm text-[#cbc3d7] hover:text-white transition-colors font-medium"
					>
						{link.label}
					</a>
				))}
			</nav>

			<div class="flex items-center gap-3">
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="hidden sm:flex items-center justify-center px-4 py-2 bg-[#8B5CF6]/10 text-[#8B5CF6] border border-[#8B5CF6]/30 font-mono text-xs font-semibold rounded-lg hover:bg-[#8B5CF6] hover:text-white transition-all shadow-[0_0_15px_rgba(139,92,246,0.2)]"
				>
					LAUNCH CONSOLE
				</a>

				<!-- Mobile Hamburger Toggle -->
				<button 
					id="mobile-menu-btn"
					type="button"
					aria-label="Toggle Navigation Menu"
					class="md:hidden w-10 h-10 rounded-lg border border-[#222222] bg-[#121315] flex items-center justify-center text-slate-300 hover:text-white hover:border-[#8B5CF6]/40 transition-all focus:outline-none"
				>
					<span id="menu-icon" class="material-symbols-outlined text-2xl">menu</span>
				</button>
			</div>
		</div>

		<!-- Mobile Navigation Drawer -->
		<div id="mobile-menu" class="hidden md:hidden border-b border-[#222222] bg-[#0c0d0f] px-6 py-4 transition-all duration-300">
			<div class="flex flex-col gap-3 font-medium text-sm">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						class="py-2 text-[#cbc3d7] hover:text-[#8B5CF6] transition-colors border-b border-[#222222]/40 last:border-0"
					>
						{link.label}
					</a>
				))}
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="mt-2 w-full py-2.5 bg-[#8B5CF6] text-white font-mono text-xs font-bold rounded-lg text-center shadow-lg shadow-[#8B5CF6]/20 flex items-center justify-center gap-2"
				>
					LAUNCH CONSOLE <span class="material-symbols-outlined text-sm">arrow_forward</span>
				</a>
			</div>
		</div>
	</header>

	<!-- Main Content -->
	<main class="w-full pt-16">
		<div class="flex flex-col w-full relative z-0">
			<!-- Background Glow & Grid Overlay -->
			<div class="absolute inset-0 z-[-1] pointer-events-none opacity-[0.2]" style="background-image: radial-gradient(circle at 50% 0%, #8B5CF6 0%, transparent 50%);"></div>
			<div class="absolute inset-0 z-[-1] pointer-events-none opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E'); background-size: 30px 30px;"></div>

			<!-- Hero Section -->
			<section class="w-full min-h-[680px] sm:min-h-[750px] flex flex-col items-center justify-center pt-16 sm:pt-24 pb-16 sm:pb-20 px-4 sm:px-6 relative overflow-hidden">
				<div class="max-w-5xl mx-auto text-center relative z-10 flex flex-col items-center gap-6 sm:gap-8">
					<div class="inline-flex items-center gap-2 sm:gap-2.5 px-3.5 sm:px-4 py-1.5 rounded-full border border-[#8B5CF6]/40 bg-[#8B5CF6]/10 shadow-[0_0_20px_rgba(139,92,246,0.15)]">
						<span class="w-2 h-2 rounded-full bg-[#8B5CF6] animate-pulse"></span>
						<span class="font-mono text-[#8B5CF6] uppercase tracking-widest text-[10px] sm:text-[11px] font-semibold">PRISM CONTROL PLANE v2.1</span>
					</div>

					<h1 class="font-bold text-[32px] xs:text-[40px] sm:text-[56px] md:text-[72px] lg:text-[78px] leading-[1.1] sm:leading-[1.05] tracking-tight text-white max-w-4xl">
						One Control Plane for Your Entire <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8B5CF6] via-indigo-400 to-purple-300">AI Stack</span>.
					</h1>

					<p class="text-base sm:text-xl md:text-2xl text-[#cbc3d7] max-w-3xl leading-relaxed font-normal px-2">
						Unify models, tools, resources, and agents behind one intelligent, resilient infrastructure layer.
					</p>

					<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full sm:w-auto mt-2 px-4 sm:px-0">
						<a 
							href="https://app.prism.roozylabs.com/login" 
							class="h-12 px-8 bg-[#8B5CF6] text-white font-mono text-xs font-bold rounded-xl hover:bg-[#7C3AED] transition-all shadow-[0_0_25px_rgba(139,92,246,0.4)] flex items-center justify-center gap-2"
						>
							GET STARTED FREE <span class="material-symbols-outlined text-sm">arrow_forward</span>
						</a>
						<a 
							href="https://github.com/roozylabs/prism" 
							target="_blank" 
							class="h-12 px-8 bg-[#121315] text-[#e3e2e3] font-mono text-xs font-semibold rounded-xl border border-[#222222] hover:bg-[#1a1b1d] hover:border-[#8B5CF6]/40 transition-all flex items-center justify-center gap-2"
						>
							<span class="material-symbols-outlined text-sm">code</span> VIEW ON GITHUB
						</a>
					</div>

					<!-- Live Terminal Code Preview -->
					<div class="w-full max-w-3xl mt-6 sm:mt-8 rounded-xl border border-[#222222] bg-[#0c0d0f] p-3 sm:p-4 text-left font-mono text-[11px] sm:text-xs shadow-2xl shadow-purple-950/20 relative">
						<div class="flex flex-wrap items-center justify-between border-b border-[#222222] pb-2.5 mb-3 gap-2">
							<div class="flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
								<span class="ml-1 text-slate-400 font-sans text-xs">opencode.jsonc ➔ Prism Gateway</span>
							</div>
							<span class="text-[10px] text-[#8B5CF6] bg-[#8B5CF6]/10 px-2 py-0.5 rounded border border-[#8B5CF6]/20 font-mono">Proxy: https://api.prism.roozylabs.com</span>
						</div>
						<div class="overflow-x-auto">
							<pre class="text-slate-300 leading-relaxed min-w-[320px]"><code><span class="text-purple-400">{</span>
  <span class="text-cyan-300">"provider"</span>: <span class="text-emerald-400">"prism"</span>,
  <span class="text-cyan-300">"api_url"</span>: <span class="text-emerald-400">"https://api.prism.roozylabs.com"</span>,
  <span class="text-cyan-300">"api_key"</span>: <span class="text-emerald-400">"gw_sk_prism_8f9a2b1c..."</span>,
  <span class="text-cyan-300">"model"</span>: <span class="text-purple-400">"prism-auto"</span> <span class="text-slate-500">// Smart Router selects best provider & model dynamically!</span>
<span class="text-purple-400">}</span></code></pre>
						</div>
					</div>
				</div>
			</section>

			<!-- Compatible AI Tool Ecosystem Ribbon -->
			<section class="w-full py-10 sm:py-12 px-4 sm:px-6 bg-[#0c0d0f]/80 border-y border-[#222222]/40">
				<div class="max-w-7xl mx-auto flex flex-col items-center gap-6">
					<p class="font-mono text-[11px] sm:text-xs uppercase tracking-widest text-[#cbc3d7]/60 text-center">Seamlessly Connects With Your Favorite AI Tools & Frameworks</p>
					
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-4 w-full">
						{clientEcosystem.map((client) => (
							<div class="flex items-center gap-3 p-3.5 bg-[#08090a] border border-[#222222]/60 rounded-xl hover:border-[#8B5CF6]/40 transition-colors">
								<span class="material-symbols-outlined text-[#8B5CF6] text-xl shrink-0">{client.icon}</span>
								<div class="min-w-0">
									<div class="font-semibold text-xs text-slate-200 truncate">{client.name}</div>
									<div class="text-[10px] text-[#cbc3d7]/60 truncate">{client.type}</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- The Problem: The Complexity Crisis Matrix -->
			<section class="w-full py-16 sm:py-24 px-4 sm:px-6 bg-[#08090a] relative">
				<div class="max-w-7xl mx-auto flex flex-col gap-8 sm:gap-12">
					<div class="text-center">
						<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">The AI Infrastructure Crisis</h2>
						<p class="text-[#cbc3d7] max-w-2xl mx-auto text-sm sm:text-base">Managing multiple AI API keys across various tools leads to rate limit crashes, hidden costs, and zero security governance.</p>
					</div>

					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
						<!-- Without Prism -->
						<div class="bg-[#0c0d0f] border border-red-500/30 rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
							<div class="absolute top-0 right-0 px-3 sm:px-4 py-1 bg-red-500/10 text-red-400 font-mono text-[10px] uppercase font-bold border-b border-l border-red-500/20 rounded-bl-xl">FRAGILE</div>
							<h3 class="text-red-400 font-semibold text-lg sm:text-xl mb-4 sm:mb-6 flex items-center gap-2.5">
								<span class="material-symbols-outlined text-xl sm:text-2xl">cancel</span> Without Prism
							</h3>
							<ul class="space-y-3.5 text-[#cbc3d7] font-mono text-xs sm:text-sm">
								<li class="flex items-start gap-3">
									<span class="text-red-400 font-bold mt-0.5 shrink-0">✕</span> Hardcoded API keys scattered across CLI tools, IDEs, and local `.env` files
								</li>
								<li class="flex items-start gap-3">
									<span class="text-red-400 font-bold mt-0.5 shrink-0">✕</span> 429 Rate Limit crashes force manual API key replacements during active coding
								</li>
								<li class="flex items-start gap-3">
									<span class="text-red-400 font-bold mt-0.5 shrink-0">✕</span> Zero token cost visibility — unpredictable end-of-month AI billing shocks
								</li>
								<li class="flex items-start gap-3">
									<span class="text-red-400 font-bold mt-0.5 shrink-0">✕</span> Complete vendor lock-in to single providers without automatic failover
								</li>
							</ul>
						</div>

						<!-- With Prism -->
						<div class="bg-[#0c0d0f] border border-[#8B5CF6]/40 rounded-2xl p-6 sm:p-8 shadow-[0_0_35px_rgba(139,92,246,0.1)] relative overflow-hidden">
							<div class="absolute top-0 right-0 px-3 sm:px-4 py-1 bg-[#8B5CF6]/20 text-[#8B5CF6] font-mono text-[10px] uppercase font-bold border-b border-l border-[#8B5CF6]/30 rounded-bl-xl">RESILIENT</div>
							<div class="absolute inset-0 bg-gradient-to-br from-[#8B5CF6]/5 to-transparent pointer-events-none"></div>
							<h3 class="text-[#8B5CF6] font-semibold text-lg sm:text-xl mb-4 sm:mb-6 flex items-center gap-2.5 relative z-10">
								<span class="material-symbols-outlined text-xl sm:text-2xl">check_circle</span> With Prism
							</h3>
							<ul class="space-y-3.5 text-[#cbc3d7] font-mono text-xs sm:text-sm relative z-10">
								<li class="flex items-start gap-3">
									<span class="text-[#8B5CF6] font-bold mt-0.5 shrink-0">✓</span> Single Gateway API Key connects all client tools to your central control plane
								</li>
								<li class="flex items-start gap-3">
									<span class="text-[#8B5CF6] font-bold mt-0.5 shrink-0">✓</span> Intelligent Smart Router (`prism-auto`) auto-routes prompts by complexity & cost
								</li>
								<li class="flex items-start gap-3">
									<span class="text-[#8B5CF6] font-bold mt-0.5 shrink-0">✓</span> 60-Second Cooldown Quarantine & instant zero-delay fallback rotation
								</li>
								<li class="flex items-start gap-3">
									<span class="text-[#8B5CF6] font-bold mt-0.5 shrink-0">✓</span> FinOps Budget Manager & SHA-256 cryptographic AI Audit Logs
								</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- 11 Core Pillars Architecture Grid -->
			<section id="pillars" class="w-full py-16 sm:py-24 px-4 sm:px-6 bg-[#0c0d0f] border-t border-[#222222]/40">
				<div class="max-w-7xl mx-auto">
					<div class="text-center mb-12 sm:mb-16">
						<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8B5CF6]/10 border border-[#8B5CF6]/20 font-mono text-xs text-[#8B5CF6] mb-3">
							SYSTEM ARCHITECTURE
						</div>
						<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">The 11 Pillars of Prism</h2>
						<p class="text-[#cbc3d7] max-w-2xl mx-auto text-sm sm:text-base">Comprehensive control plane built strictly according to enterprise gateway specifications.</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
						{pillars.map((pillar) => (
							<div class="p-5 sm:p-6 border border-[#222222] rounded-2xl bg-[#08090a] hover:border-[#8B5CF6]/50 transition-all duration-300 flex flex-col justify-between group hover:shadow-[0_0_25px_rgba(139,92,246,0.1)]">
								<div>
									<div class="flex items-center justify-between mb-4">
										<div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-[#8B5CF6]/10 border border-[#8B5CF6]/20 flex items-center justify-center group-hover:bg-[#8B5CF6] transition-colors">
											<span class="material-symbols-outlined text-[#8B5CF6] group-hover:text-white text-xl sm:text-2xl transition-colors">{pillar.icon}</span>
										</div>
										<span class="font-mono text-xs text-[#cbc3d7]/40 font-bold">PILLAR {pillar.id < 10 ? `0${pillar.id}` : pillar.id}</span>
									</div>
									<h3 class="text-base sm:text-lg font-bold text-white mb-1">{pillar.title}</h3>
									<p class="font-mono text-xs text-[#8B5CF6] mb-3">{pillar.tagline}</p>
									<p class="text-[#cbc3d7] text-xs leading-relaxed mb-6">{pillar.description}</p>
								</div>

								<div class="pt-4 border-t border-[#222222]/50 flex flex-wrap gap-1.5">
									{pillar.highlights.map((tag) => (
										<span class="px-2 py-0.5 rounded bg-[#121315] border border-[#222222] font-mono text-[10px] text-slate-300">
											{tag}
										</span>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Integration Code Showcase -->
			<section id="integration" class="w-full py-16 sm:py-24 px-4 sm:px-6 bg-[#08090a] border-t border-[#222222]/40">
				<div class="max-w-5xl mx-auto flex flex-col gap-8 sm:gap-10">
					<div class="text-center">
						<h2 class="text-2xl sm:text-3xl font-bold text-white mb-3 sm:mb-4">1-Minute Client Setup</h2>
						<p class="text-[#cbc3d7] max-w-xl mx-auto text-sm sm:text-base">Point any AI tool or SDK to your Prism Gateway Endpoint.</p>
					</div>

					<div class="rounded-2xl border border-[#222222] bg-[#0c0d0f] p-4 sm:p-6 shadow-2xl">
						<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-[#222222] pb-4 mb-4 gap-3">
							<div class="flex flex-wrap items-center gap-2 font-mono text-xs">
								<span class="px-3 py-1 rounded-lg bg-[#8B5CF6] text-white font-bold">OpenCode CLI</span>
