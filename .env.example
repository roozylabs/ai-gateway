# ==========================================
# AI Gateway Production Environment Template
# Place this file as `.env` in root VPS folder
# ==========================================

APP_ENV=production
SERVER_PORT=8080
APP_PORT=3000

# PostgreSQL Database Configuration
POSTGRES_DB=ai_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_here
POSTGRES_PORT=5433

# Redis Cache Configuration
REDIS_PASSWORD=secure_redis_password_here
REDIS_PORT=6379

# Security Keys
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_32_byte_secret_encryption_key
HASH_KEY=your_hash_key_here

# Frontend Next.js Server-side Proxy Target (Internal Docker Network)
API_URL=http://api:8080
