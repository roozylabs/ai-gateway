---
export interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "Prism AI Gateway - One Control Plane for Your Entire AI Stack. Unify models, tools, resources, and agents behind one intelligent infrastructure layer." 
}: Props = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts & Material Symbols -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-[#08090a] font-['Inter',sans-serif] text-[#e3e2e3] antialiased selection:bg-[#8B5CF6] selection:text-white min-h-screen flex flex-col overflow-x-hidden">
		<slot />
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	@layer base {
		html, body {
			margin: 0;
			padding: 0;
			background-color: #08090a;
		}
		body {
			overscroll-behavior: none;
		}
	}
	
	::-webkit-scrollbar {
		display: none;
	}
</style>
