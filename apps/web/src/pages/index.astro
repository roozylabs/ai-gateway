---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Roozy Prism AI Gateway - Universal Multi-Provider LLM Router & Infrastructure">
	<!-- Navbar -->
	<nav class="sticky top-0 z-50 backdrop-blur-xl bg-[#0B0F17]/80 border-b border-slate-800/80">
		<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
			<div class="flex items-center gap-3">
				<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-violet-500 to-pink-500 flex items-center justify-center shadow-lg shadow-purple-500/25">
					<span class="text-white font-black text-xl tracking-wider">P</span>
				</div>
				<div class="flex flex-col">
					<span class="font-bold text-lg tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-purple-300">Prism AI Gateway</span>
					<span class="text-[10px] text-purple-400 font-mono font-medium tracking-widest uppercase">BY ROOZYLABS</span>
				</div>
			</div>

			<div class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
				<a href="#features" class="hover:text-purple-400 transition-colors">Features</a>
				<a href="#architecture" class="hover:text-purple-400 transition-colors">Architecture</a>
				<a href="#audit" class="hover:text-purple-400 transition-colors">AI Audit Trail</a>
				<a href="#code" class="hover:text-purple-400 transition-colors">CLI & SDKs</a>
			</div>

			<div class="flex items-center gap-4">
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="px-5 py-2.5 rounded-xl font-semibold text-sm bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white shadow-lg shadow-purple-600/30 transition-all hover:scale-105 active:scale-95"
				>
					Console Login &rarr;
				</a>
			</div>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="relative pt-24 pb-20 overflow-hidden">
		<!-- Background Glow Gradients -->
		<div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-purple-600/15 rounded-full blur-[140px] pointer-events-none"></div>
		<div class="absolute top-1/3 left-1/3 w-[400px] h-[400px] bg-pink-600/10 rounded-full blur-[120px] pointer-events-none"></div>

		<div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
			<!-- Status Pill -->
			<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/90 border border-purple-500/30 text-purple-300 text-xs font-semibold mb-8 backdrop-blur-md">
				<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
				<span>Pillar 1-11 Production Ready • Ultra Low Latency Proxy Engine</span>
			</div>

			<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight max-w-4xl mx-auto leading-[1.15] mb-8">
				One Universal Gateway for All Your <span class="bg-clip-text text-transparent bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400">AI Agents & Models</span>
			</h1>

			<p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 font-normal leading-relaxed">
				Route OpenAI, Anthropic, Google Gemini, and OpenCode through an enterprise proxy engine with automatic failovers, declarative RBAC, zero-latency caching, and cryptographic audit trails.
			</p>

			<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-base bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white shadow-xl shadow-purple-600/30 transition-all hover:scale-105 active:scale-95"
				>
					Start Building Free &rarr;
				</a>
				<a 
					href="https://api.prism.roozylabs.com/health" 
					target="_blank"
					class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-base bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 transition-all hover:bg-slate-800/50"
				>
					Check API Gateway Status
				</a>
			</div>

			<!-- Terminal Mockup -->
			<div class="max-w-3xl mx-auto rounded-2xl bg-[#121824] border border-slate-800 shadow-2xl overflow-hidden text-left font-mono text-sm">
				<div class="px-4 py-3 bg-[#0D121D] border-b border-slate-800 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="w-3 h-3 rounded-full bg-red-500/80"></div>
						<div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
						<div class="w-3 h-3 rounded-full bg-green-500/80"></div>
						<span class="ml-2 text-xs text-slate-500 font-sans">OpenCode CLI & Gateway Config</span>
					</div>
					<span class="text-xs text-purple-400">https://prism.roozylabs.com/v1</span>
				</div>
				<div class="p-6 text-slate-300 space-y-3 overflow-x-auto leading-relaxed">
					<p class="text-slate-500"># Configure OpenCode CLI to route through Prism Agent Infrastructure</p>
					<p><span class="text-purple-400">curl</span> -X POST https://prism.roozylabs.com/v1/chat/completions \</p>
					<p class="pl-4"><span class="text-pink-400">-H</span> <span class="text-emerald-300">"Authorization: Bearer sk-prism-gateway-key"</span> \</p>
					<p class="pl-4"><span class="text-pink-400">-H</span> <span class="text-emerald-300">"X-Prism-Agent-ID: dev-agent"</span> \</p>
					<p class="pl-4"><span class="text-pink-400">-H</span> <span class="text-emerald-300">"X-Prism-Role: developer"</span> \</p>
					<p class="pl-4"><span class="text-pink-400">-d</span> <span class="text-cyan-300">'{"model":"prism-auto","messages":[{"role":"user","content":"Refactor Go API"}]}'</span></p>
				</div>
			</div>
		</div>
	</section>

	<!-- Feature Grid -->
	<section id="features" class="py-24 bg-[#0D121D] border-t border-b border-slate-800/60 relative">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center max-w-3xl mx-auto mb-16">
				<h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">Enterprise Capabilities Out-of-the-Box</h2>
				<p class="text-slate-400 text-base">Built for AI engineering teams demanding reliability, auditability, and optimal model economics.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Card 1 -->
				<div class="p-8 rounded-2xl bg-[#121824] border border-slate-800 hover:border-purple-500/50 transition-all hover:-translate-y-1">
					<div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-xl mb-6">⚡</div>
					<h3 class="text-xl font-bold text-white mb-3">Smart Router & Fallbacks</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Dynamic fallback chains across OpenAI, Anthropic, and Google. Never encounter 5xx provider outages again.</p>
				</div>
				<!-- Card 2 -->
				<div class="p-8 rounded-2xl bg-[#121824] border border-slate-800 hover:border-pink-500/50 transition-all hover:-translate-y-1">
					<div class="w-12 h-12 rounded-xl bg-pink-500/10 text-pink-400 flex items-center justify-center font-bold text-xl mb-6">🤖</div>
					<h3 class="text-xl font-bold text-white mb-3">Agent Governance</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Assign allowed models, execution tool whitelists, and dollar budget caps per agent identity.</p>
				</div>
				<!-- Card 3 -->
				<div class="p-8 rounded-2xl bg-[#121824] border border-slate-800 hover:border-cyan-500/50 transition-all hover:-translate-y-1">
					<div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-bold text-xl mb-6">🛡️</div>
					<h3 class="text-xl font-bold text-white mb-3">Declarative RBAC Engine</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Enforce role-based access control policies (Developer, Auditor, Admin) directly on inference requests.</p>
				</div>
				<!-- Card 4 -->
				<div class="p-8 rounded-2xl bg-[#121824] border border-slate-800 hover:border-emerald-500/50 transition-all hover:-translate-y-1">
					<div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-xl mb-6">🔒</div>
					<h3 class="text-xl font-bold text-white mb-3">Cryptographic AI Audit Trail</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Tamper-evident SHA-256 signatures for every prompt, completion, and tool invocation.</p>
				</div>
				<!-- Card 5 -->
				<div class="p-8 rounded-2xl bg-[#121824] border border-slate-800 hover:border-amber-500/50 transition-all hover:-translate-y-1">
					<div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-xl mb-6">📊</div>
					<h3 class="text-xl font-bold text-white mb-3">FinOps & Cost Anomalies</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Real-time spend tracking per Gateway Key and automated background scanners for token spikes.</p>
				</div>
				<!-- Card 6 -->
				<div class="p-8 rounded-2xl bg-[#121824] border border-slate-800 hover:border-indigo-500/50 transition-all hover:-translate-y-1">
					<div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-bold text-xl mb-6">📡</div>
					<h3 class="text-xl font-bold text-white mb-3">Real-time SSE Telemetry</h3>
					<p class="text-slate-400 text-sm leading-relaxed">Live streaming event channel pushed directly to Next.js dashboard widgets via Redis Pub/Sub.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="py-12 border-t border-slate-800/80 bg-[#0B0F17]">
		<div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
			<div class="flex items-center gap-3">
				<div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-purple-600 to-pink-500 flex items-center justify-center font-bold text-white text-sm">P</div>
				<span class="text-sm font-semibold text-slate-300">Roozy Prism AI Gateway &copy; 2026</span>
			</div>
			<div class="flex items-center gap-6 text-xs text-slate-500">
				<a href="https://app.prism.roozylabs.com/login" class="hover:text-purple-400">Console Dashboard</a>
				<a href="https://api.prism.roozylabs.com/health" class="hover:text-purple-400">System Status</a>
				<span>RoozyLabs Enterprise</span>
			</div>
		</div>
	</footer>
</Layout>
