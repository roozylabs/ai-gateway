---
import Layout from '../layouts/Layout.astro';
import { 
	Shield, Zap, Route, ShieldCheck, Lock, Activity, 
	Wallet, RefreshCw, KeyRound, Plug, Wrench, FileCheck, 
	Terminal, Code, Bot, Network, Globe, XCircle, CheckCircle, 
	Menu, X, Github, BookOpen 
} from 'lucide-react';

interface NavLink {
	label: string;
	href: string;
	external?: boolean;
}

const navLinks: NavLink[] = [
	{ label: 'Architecture', href: '#pillars' },
	{ label: 'Resilience', href: '#resilience' },
	{ label: 'Integration', href: '#integration' },
	{ label: 'Documentation', href: 'https://docs.prism.roozylabs.com', external: true },
	{ label: 'GitHub', href: 'https://github.com/roozylabs/prism', external: true },
];

const benchmarkStats = [
	{ value: '1.96 ms', label: 'p95 Latency Overhead', desc: 'Gateway processing overhead (sub-2ms)' },
	{ value: '3,585.5', label: 'Req / Sec Throughput', desc: 'Empirical load test at 500 workers' },
	{ value: '0 Races', label: 'Data Race Free', desc: 'Verified with go test -race ./...' },
	{ value: '9 Tables', label: 'Row Level Security', desc: 'PostgreSQL RLS tenant isolation' },
];

const clientEcosystem = [
	{ name: 'OpenCode CLI', icon: Terminal, type: 'AI Coding Assistant' },
	{ name: 'Claude Code', icon: Code, type: 'Anthropic CLI Agent' },
	{ name: 'Antigravity IDE', icon: Bot, type: 'AI Pair Programmer' },
	{ name: 'LangChain & LlamaIndex', icon: Network, type: 'Agent Frameworks' },
	{ name: 'Vercel AI SDK & Custom Apps', icon: Globe, type: 'REST and SSE SDKs' },
];

interface Pillar {
	id: number;
	icon: any;
	title: string;
	tagline: string;
	description: string;
	highlights: string[];
}

const primaryPillars: Pillar[] = [
	{
		id: 1,
		icon: Zap,
		title: 'Universal Model Gateway',
		tagline: 'Single OpenAI-Compatible Proxy Engine',
		description: 'Unify OpenAI, Anthropic, Google Gemini, OpenRouter, and OpenCode through one API key with zero-latency streaming pass-through.',
		highlights: ['/v1/chat/completions', '/v1/models', 'SSE Streaming'],
	},
	{
		id: 2,
		icon: Route,
		title: 'Prism Auto Smart Router',
		tagline: 'Prompt Classification Engine',
		description: 'Deterministic task complexity and context window analysis with candidate scoring across balanced, cheap, or quality policies.',
		highlights: ['Candidate Scoring', 'Credential Pre-Filtering', 'Policy Presets'],
	},
	{
		id: 3,
		icon: ShieldCheck,
		title: 'Deterministic Failure Resilience',
		tagline: 'Circuit Breaker & Cooldown Quarantine',
		description: 'Automatic 3x 50x error detection, 60s cooldown quarantine, 401/403 non-retry classification, and $0.00 retry billing guarantee.',
		highlights: ['3x 50x Threshold', '60s Cooldown Vault', '$0.00 Retry Billing'],
	},
];

const corePillars: Pillar[] = [
	{
		id: 4,
		icon: Lock,
		title: 'Multi-Tenant Isolation & RLS',
		tagline: 'PostgreSQL Row-Level Security',
		description: 'Multi-tenancy enforcing OrgID ownership, user-scoped query isolation across 9 database tables, and authoritative key validation.',
		highlights: ['PostgreSQL 070 RLS', 'OrgID Scoping', 'Tenant Isolation'],
	},
	{
		id: 5,
		icon: Activity,
		title: 'End-to-End Observability',
		tagline: '5 Standardized Correlation Identifiers',
		description: 'Trace every AI execution with request_id, execution_id, routing_decision_id, attempt_id, and audit_id. Secret-redacted structured JSON logging.',
		highlights: ['X-Request-ID Propagation', 'Stable execution_id', 'Secret Redaction'],
	},
	{
		id: 6,
		icon: Wallet,
		title: 'FinOps & Multi-Tenant Quotas',
		tagline: 'Real-Time Token Cost & Quota Manager',
		description: '6-dimensional token cost tracking, daily/monthly spend limits, velocity alert thresholds, and gateway key quota limits.',
		highlights: ['CostUSD Calculation', 'Velocity Alerts', 'Key Spend Quotas'],
	},
	{
		id: 7,
		icon: RefreshCw,
		title: 'Production Operations & Migrator',
		tagline: 'Blue-Green & Auto Schema Recovery',
		description: 'Standalone schema migration with auto-dirty state recovery, separate /health and /ready probes for Blue-Green zero-downtime deployment.',
		highlights: ['Auto-Dirty Reset', 'Liveness & Readiness', 'Blue-Green Deployment'],
	},
	{
		id: 8,
		icon: KeyRound,
		title: 'AES-256-GCM Vault & OAuth Exchange',
		tagline: 'Dynamic Credential Allocation Pool',
		description: 'Encrypted key vault supporting Round Robin, LRU, and Fallback Cascade rotation strategies with Google OAuth token exchange.',
		highlights: ['AES-256-GCM Vault', 'Google OAuth Refresh', 'LRU & Round Robin'],
	},
];

const protocolPillars: Pillar[] = [
	{
		id: 9,
		icon: Plug,
		title: 'MCP Protocol Gateway',
		tagline: 'Model Context Protocol Integrator',
		description: 'Connect HTTP and SSE Model Context Protocol servers (GitHub, Notion, Custom Agents) with automatic JSON-RPC 2.0 discovery.',
		highlights: ['JSON-RPC 2.0 Discovery', 'GitHub & Notion MCP', 'SSE Pass-Through'],
	},
	{
		id: 10,
		icon: Wrench,
		title: 'Resource & Tool Gateway Control',
		tagline: 'Centralized Function Calling & SQL Engine',
		description: 'Register external REST API tools and parameterized PostgreSQL query templates with header injection, priority failover, and sandbox execution.',
		highlights: ['REST API Tool Hub', 'Parameterized SQL', 'Sandbox Testing'],
	},
	{
		id: 11,
		icon: FileCheck,
		title: 'Cryptographic AI Audit Trail',
		tagline: 'SHA-256 Tamper-Proof Execution Log',
		description: '6-dimensional audit trail capturing WHO, REQUEST, MODEL, TOOLS/RESOURCES, COST, and OUTCOME with SHA-256 signature verification.',
		highlights: ['SHA-256 Signatures', '6D Telemetry Logging', 'Tamper-Proof Audit Vault'],
	},
];
---

<Layout title="RoozyLabs Prism - Universal AI Control Plane v0.3.0">
	<!-- Ambient Background Light (Static, Calm, Single Subtle Top Light) -->
	<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,rgba(139,92,246,0.08),transparent_70%)]"></div>
	</div>

	<!-- Header Navigation -->
	<header class="fixed top-0 w-full z-50 bg-background/90 backdrop-blur-md border-b border-border">
		<div class="h-14 max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-4">
			<!-- Brand Mark (Matching AuthLayout.tsx) -->
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-2.5">
					<div class="flex h-8 w-8 items-center justify-center rounded-none bg-[#7C3AED] text-white border border-violet-400/30">
						<Shield className="h-4 w-4" />
					</div>
					<div class="flex flex-col">
						<span class="font-mono text-sm font-bold tracking-tight text-foreground">
							RoozyLabs <span class="text-primary">Prism</span>
						</span>
					</div>
				</a>
			</div>
			
			<!-- Desktop Nav Links -->
			<nav class="hidden md:flex items-center gap-6 lg:gap-8">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						rel={link.external ? "noopener noreferrer" : undefined}
						class="text-xs text-muted-foreground hover:text-foreground transition-colors font-medium"
					>
						{link.label}
					</a>
				))}
			</nav>

			<div class="flex items-center gap-3">
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="hidden sm:inline-flex items-center justify-center px-3.5 py-1.5 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-none hover:bg-primary/90 transition-colors"
				>
					Open Console
				</a>

				<!-- Mobile Navigation Toggle -->
				<button 
					id="mobile-menu-btn"
					type="button"
					aria-label="Toggle Navigation Menu"
					aria-expanded="false"
					class="md:hidden h-9 px-2.5 rounded-none border border-border bg-card flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground hover:border-border transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
				>
					<span id="menu-icon-open"><Menu className="h-4 w-4" /></span>
					<span id="menu-icon-close" class="hidden"><X className="h-4 w-4" /></span>
					<span class="font-mono text-[11px]">Menu</span>
				</button>
			</div>
		</div>

		<!-- Mobile Navigation Drawer -->
		<div id="mobile-menu" class="hidden md:hidden border-b border-border bg-card px-6 py-4">
			<div class="flex flex-col gap-2.5 font-medium text-xs">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						rel={link.external ? "noopener noreferrer" : undefined}
						class="py-2 text-muted-foreground hover:text-foreground transition-colors border-b border-border last:border-0"
					>
						{link.label}
					</a>
				))}
				<a 
					href="https://app.prism.roozylabs.com/login" 
					class="mt-2 w-full py-2 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-none text-center"
				>
					Open Console
				</a>
			</div>
		</div>
	</header>

	<!-- Main Content -->
	<main class="w-full pt-14 flex-1">
		<div class="flex flex-col w-full relative z-0">
			<!-- Hero Section -->
			<section class="w-full py-16 sm:py-24 px-4 sm:px-6 flex flex-col items-center justify-center text-center">
				<div class="max-w-4xl mx-auto flex flex-col items-center gap-6">
					<!-- Version & System Badge -->
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-none border border-border bg-card text-xs font-mono">
						<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
						<span class="text-muted-foreground uppercase tracking-wider text-[11px]">Control Plane v0.3.0</span>
					</div>

					<h1 class="font-bold text-3xl sm:text-5xl md:text-6xl leading-[1.1] tracking-tight text-foreground max-w-3xl">
						One Control Plane for Your Entire <span class="text-primary">AI Stack</span>
					</h1>

					<p class="text-sm sm:text-base md:text-lg text-muted-foreground max-w-2xl leading-relaxed">
						Sub-2ms Gateway Engine, Multi-Tenant Row-Level Security, Deterministic Auto-Failover, and Correlation Observability.
					</p>

					<!-- Action Buttons (1 Deliberate Accent Glow on Primary CTA) -->
					<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto mt-2">
						<a 
							href="https://app.prism.roozylabs.com/login" 
							class="h-10 px-6 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-none hover:bg-primary/90 transition-all shadow-[0_0_20px_rgba(139,92,246,0.25)] flex items-center justify-center"
						>
							Open Console
						</a>
						<a 
							href="https://github.com/roozylabs/prism" 
							target="_blank" 
							rel="noopener noreferrer"
							class="h-10 px-6 bg-card text-foreground font-mono text-xs font-semibold rounded-none border border-border hover:bg-secondary transition-colors flex items-center justify-center gap-2"
						>
							<Github className="h-4 w-4" /> View Source
						</a>
					</div>

					<!-- Clean JSON Code Preview (No decorative traffic dots) -->
					<div class="w-full max-w-2xl mt-6 rounded-none border border-border bg-console p-4 text-left font-mono text-xs">
						<div class="flex items-center justify-between border-b border-border pb-2 mb-3 text-[11px] text-muted-foreground">
							<span>opencode.jsonc config</span>
							<span class="text-primary">https://api.prism.roozylabs.com</span>
						</div>
						<div class="overflow-x-auto">
							<pre class="text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-purple-400">&#123;</span>
  <span class="text-cyan-400">"provider"</span>: <span class="text-emerald-400">"prism"</span>,
  <span class="text-cyan-400">"api_url"</span>: <span class="text-emerald-400">"https://api.prism.roozylabs.com"</span>,
  <span class="text-cyan-400">"api_key"</span>: <span class="text-emerald-400">"gw_sk_live_85061cbfc18e4ca58e0e..."</span>,
  <span class="text-cyan-400">"model"</span>: <span class="text-purple-400">"prism-auto"</span>, <span class="text-slate-500">// Smart Router auto-selects best model & provider</span>
  <span class="text-cyan-400">"extra_headers"</span>: <span class="text-purple-400">&#123;</span>
    <span class="text-cyan-400">"X-Request-ID"</span>: <span class="text-emerald-400">"req_uuid_v4"</span>,
    <span class="text-cyan-400">"X-Prism-Agent-ID"</span>: <span class="text-emerald-400">"opencode-agent-v2"</span>
  <span class="text-purple-400">&#125;</span>
<span class="text-purple-400">&#125;</span></code></pre>
						</div>
					</div>
				</div>
			</section>

			<!-- Performance Benchmark & SLA Stats Ribbon -->
			<section class="w-full py-8 px-4 sm:px-6 bg-card border-y border-border">
				<div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
					{benchmarkStats.map((stat) => (
						<div class="p-4 bg-background border border-border rounded-none flex flex-col items-center text-center">
							<span class="font-mono font-bold text-xl sm:text-2xl text-primary">{stat.value}</span>
							<span class="font-semibold text-xs text-foreground mt-1">{stat.label}</span>
							<span class="font-mono text-[11px] text-muted-foreground mt-0.5">{stat.desc}</span>
						</div>
					))}
				</div>
			</section>

			<!-- Compatible AI Tool Ecosystem Ribbon -->
			<section class="w-full py-10 px-4 sm:px-6 bg-background border-b border-border">
				<div class="max-w-7xl mx-auto flex flex-col items-center gap-6">
					<div class="text-center">
						<span class="font-mono text-xs text-primary uppercase tracking-wider font-semibold">Integrations</span>
						<h2 class="text-lg font-bold text-foreground mt-1">Compatible AI Clients</h2>
					</div>
					
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 w-full">
						{clientEcosystem.map((client) => {
							const IconComponent = client.icon;
							return (
								<div class="flex items-center gap-3 p-3 bg-card border border-border rounded-none hover:border-primary/50 transition-colors">
									<div class="w-8 h-8 rounded-none bg-primary/10 flex items-center justify-center text-primary shrink-0">
										<IconComponent className="h-4 w-4" />
									</div>
									<div class="min-w-0">
										<div class="font-semibold text-xs text-foreground truncate">{client.name}</div>
										<div class="text-[11px] text-muted-foreground truncate">{client.type}</div>
									</div>
								</div>
							);
						})}
					</div>
				</div>
			</section>

			<!-- Resilience Comparison Section -->
			<section id="resilience" class="w-full py-16 sm:py-20 px-4 sm:px-6 bg-background">
				<div class="max-w-7xl mx-auto flex flex-col gap-8 sm:gap-10">
					<div class="text-center">
						<span class="font-mono text-xs text-red-400 uppercase tracking-wider font-semibold">Resilience</span>
						<h2 class="text-2xl sm:text-3xl font-bold text-foreground mt-1 mb-2">Direct Provider Access vs. Prism Resilience</h2>
						<p class="text-muted-foreground max-w-2xl mx-auto text-xs sm:text-sm">
							Connecting tools directly to upstream AI APIs exposes applications to rate limits, unexpected outages, and unmonitored costs.
						</p>
					</div>

					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						<!-- Without Prism -->
						<div class="bg-card border border-red-500/30 rounded-none p-6 relative">
							<div class="flex items-center justify-between mb-4 border-b border-border pb-3">
								<h3 class="text-red-400 font-semibold text-sm sm:text-base flex items-center gap-2">
									<XCircle className="h-4 w-4" /> Without Prism
								</h3>
								<span class="px-2 py-0.5 bg-red-500/10 text-red-400 font-mono text-[10px] uppercase font-bold border border-red-500/20">
									Direct Upstream
								</span>
							</div>
							<ul class="space-y-3 text-muted-foreground text-xs sm:text-sm">
								<li class="flex items-start gap-2.5">
									<span class="text-red-400 font-bold shrink-0">✕</span> API keys scattered across multiple local configuration files.
								</li>
								<li class="flex items-start gap-2.5">
									<span class="text-red-400 font-bold shrink-0">✕</span> 429 Rate Limit errors interrupt workflows without automatic retry fallback.
								</li>
								<li class="flex items-start gap-2.5">
									<span class="text-red-400 font-bold shrink-0">✕</span> Provider outages stall development with no automatic model failover.
								</li>
								<li class="flex items-start gap-2.5">
									<span class="text-red-400 font-bold shrink-0">✕</span> Unmonitored token spend with no organization-level budget enforcement.
								</li>
							</ul>
						</div>

						<!-- With Prism -->
						<div class="bg-card border border-primary/40 rounded-none p-6 relative">
							<div class="flex items-center justify-between mb-4 border-b border-border pb-3">
								<h3 class="text-primary font-semibold text-sm sm:text-base flex items-center gap-2">
									<CheckCircle className="h-4 w-4" /> With Prism v0.3.0
								</h3>
								<span class="px-2 py-0.5 bg-primary/10 text-primary font-mono text-[10px] uppercase font-bold border border-primary/30">
									Control Plane
								</span>
							</div>
							<ul class="space-y-3 text-muted-foreground text-xs sm:text-sm">
								<li class="flex items-start gap-2.5">
									<span class="text-primary font-bold shrink-0">✓</span> Single Gateway API Key backed by PostgreSQL Row-Level Security isolation.
								</li>
								<li class="flex items-start gap-2.5">
									<span class="text-primary font-bold shrink-0">✓</span> Smart Router auto-routes prompts by complexity, model capability, and cost policy.
								</li>
								<li class="flex items-start gap-2.5">
									<span class="text-primary font-bold shrink-0">✓</span> Circuit breaker quarantine with 60s cooldown and $0.00 retry billing guarantee.
								</li>
								<li class="flex items-start gap-2.5">
									<span class="text-primary font-bold shrink-0">✓</span> 5 standardized correlation IDs (`execution_id`) and SHA-256 tamper-proof audit trail.
								</li>
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- 11 Pillars of Prism (Varied Composition Layout) -->
			<section id="pillars" class="w-full py-16 sm:py-20 px-4 sm:px-6 bg-card border-t border-border">
				<div class="max-w-7xl mx-auto flex flex-col gap-10">
					<div class="text-center">
						<span class="font-mono text-xs text-primary uppercase tracking-wider font-semibold">Architecture</span>
						<h2 class="text-2xl sm:text-3xl font-bold text-foreground mt-1 mb-2">The 11 Pillars of Prism</h2>
						<p class="text-muted-foreground max-w-2xl mx-auto text-xs sm:text-sm">
							Engineered control plane specifications for model routing, resilience, security, and governance.
						</p>
					</div>

					<!-- Tier 1: Featured Primary Pillars (3 Prominent Cards) -->
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
						{primaryPillars.map((pillar) => {
							const IconComponent = pillar.icon;
							return (
								<div class="p-5 sm:p-6 border border-border rounded-none bg-background flex flex-col justify-between hover:border-primary/50 transition-colors">
									<div>
										<div class="flex items-center justify-between mb-4">
											<div class="w-10 h-10 rounded-none bg-[#7C3AED] text-white flex items-center justify-center">
												<IconComponent className="h-5 w-5" />
											</div>
											<span class="font-mono text-xs text-muted-foreground font-bold">PILLAR 0{pillar.id}</span>
										</div>
										<h3 class="text-base font-bold text-foreground mb-1">{pillar.title}</h3>
										<p class="font-mono text-xs text-primary mb-2.5">{pillar.tagline}</p>
										<p class="text-muted-foreground text-xs leading-relaxed mb-4">{pillar.description}</p>
									</div>

									<div class="pt-3 border-t border-border flex flex-wrap gap-1.5">
										{pillar.highlights.map((tag) => (
											<span class="px-2 py-0.5 rounded-none bg-card border border-border font-mono text-[10px] text-muted-foreground">
												{tag}
											</span>
										))}
									</div>
								</div>
							);
						})}
					</div>

					<!-- Tier 2: Core System Pillars (2-Column Grid) -->
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
						{corePillars.map((pillar) => {
							const IconComponent = pillar.icon;
							return (
								<div class="p-4 sm:p-5 border border-border rounded-none bg-background flex flex-col justify-between hover:border-primary/40 transition-colors">
									<div>
										<div class="flex items-center justify-between mb-3">
											<div class="w-8 h-8 rounded-none bg-secondary text-primary flex items-center justify-center">
												<IconComponent className="h-4 w-4" />
											</div>
											<span class="font-mono text-xs text-muted-foreground">0{pillar.id}</span>
										</div>
										<h4 class="text-sm font-bold text-foreground mb-0.5">{pillar.title}</h4>
										<p class="font-mono text-[11px] text-primary mb-2">{pillar.tagline}</p>
										<p class="text-muted-foreground text-xs leading-relaxed mb-3">{pillar.description}</p>
									</div>

									<div class="pt-2.5 border-t border-border flex flex-wrap gap-1">
										{pillar.highlights.map((tag) => (
											<span class="px-1.5 py-0.5 rounded-none bg-card border border-border font-mono text-[10px] text-muted-foreground">
												{tag}
											</span>
										))}
									</div>
								</div>
							);
						})}
					</div>

					<!-- Tier 3: Protocol & Extensibility Pillars (3 Compact Cards) -->
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
						{protocolPillars.map((pillar) => {
							const IconComponent = pillar.icon;
							return (
								<div class="p-4 border border-border rounded-none bg-background flex flex-col justify-between hover:border-primary/40 transition-colors">
									<div>
										<div class="flex items-center justify-between mb-2">
											<div class="w-7 h-7 rounded-none bg-secondary text-primary flex items-center justify-center">
												<IconComponent className="h-3.5 w-3.5" />
											</div>
