---
import Layout from '../layouts/Layout.astro';
import { 
	Shield, Zap, Route, ShieldCheck, Lock, Activity, 
	Wallet, RefreshCw, KeyRound, Plug, Wrench, FileCheck, 
	Terminal, Code, Bot, Network, Globe, XCircle, CheckCircle, 
	Menu, X, Github, BookOpen, Copy, ExternalLink, ArrowRight,
	Server
} from 'lucide-react';

interface NavLink {
	label: string;
	href: string;
	external?: boolean;
}

const navLinks: NavLink[] = [
	{ label: 'Architecture', href: '#pillars' },
	{ label: 'Resilience', href: '#resilience' },
	{ label: 'Quickstart', href: '#integration' },
	{ label: 'Docs', href: 'https://docs.prism.roozylabs.com', external: true },
	{ label: 'GitHub', href: 'https://github.com/roozylabs/prism', external: true },
];

const benchmarkStats = [
	{ value: '1.96 ms', label: 'p95 Latency Overhead', desc: 'Gateway processing overhead (sub-2ms)' },
	{ value: '3,585.5', label: 'Req / Sec Throughput', desc: 'Empirical load test at 500 workers' },
	{ value: '0 Races', label: 'Data Race Free', desc: 'Verified with go test -race ./...' },
	{ value: '9 Tables', label: 'Row Level Security', desc: 'PostgreSQL RLS tenant isolation' },
];

const clientEcosystem = [
	{ name: 'OpenCode CLI', icon: Terminal, type: 'AI Coding Assistant' },
	{ name: 'Claude Code', icon: Code, type: 'Anthropic CLI Agent' },
	{ name: 'Antigravity IDE', icon: Bot, type: 'AI Pair Programmer' },
	{ name: 'LangChain & LlamaIndex', icon: Network, type: 'Agent Frameworks' },
	{ name: 'Vercel AI SDK & Custom Apps', icon: Globe, type: 'REST and SSE SDKs' },
];

interface Pillar {
	id: number;
	icon: any;
	category: string;
	title: string;
	tagline: string;
	description: string;
	highlights: string[];
}

const primaryPillars: Pillar[] = [
	{
		id: 1,
		icon: Zap,
		category: 'Proxy Engine',
		title: 'Universal Model Gateway',
		tagline: 'Single OpenAI-Compatible Proxy Engine',
		description: 'Unify OpenAI, Anthropic, Google Gemini, OpenRouter, and OpenCode through one API key with zero-latency streaming pass-through.',
		highlights: ['/v1/chat/completions', '/v1/models', 'SSE Streaming Pass-Through'],
	},
	{
		id: 2,
		icon: Route,
		category: 'Smart Routing',
		title: 'Prism Auto Smart Router',
		tagline: 'Prompt Classification Engine',
		description: 'Deterministic task complexity and context window analysis with candidate scoring across balanced, cheap, or quality policies.',
		highlights: ['Candidate Scoring', 'Credential Pre-Filtering', 'Policy Presets'],
	},
	{
		id: 3,
		icon: ShieldCheck,
		category: 'Fault Tolerance',
		title: 'Deterministic Failure Resilience',
		tagline: 'Circuit Breaker & Cooldown Quarantine',
		description: 'Automatic 3x 50x error detection, 60s cooldown quarantine, 401/403 non-retry classification, and $0.00 retry billing guarantee.',
		highlights: ['3x 50x Threshold', '60s Cooldown Vault', '$0.00 Retry Billing'],
	},
];

const corePillars: Pillar[] = [
	{
		id: 4,
		icon: Lock,
		category: 'Security & RLS',
		title: 'Multi-Tenant Isolation & RLS',
		tagline: 'PostgreSQL Row-Level Security',
		description: 'Multi-tenancy enforcing OrgID ownership, user-scoped query isolation across 9 database tables, and authoritative key validation.',
		highlights: ['PostgreSQL 070 RLS', 'OrgID Scoping', 'Tenant Isolation'],
	},
	{
		id: 5,
		icon: Activity,
		category: 'Telemetry',
		title: 'End-to-End Observability',
		tagline: '5 Standardized Correlation Identifiers',
		description: 'Trace every AI execution with request_id, execution_id, routing_decision_id, attempt_id, and audit_id. Secret-redacted structured JSON logging.',
		highlights: ['X-Request-ID Propagation', 'Stable execution_id', 'Secret Redaction'],
	},
	{
		id: 6,
		icon: Wallet,
		category: 'Governance',
		title: 'FinOps & Multi-Tenant Quotas',
		tagline: 'Real-Time Token Cost & Quota Manager',
		description: '6-dimensional token cost tracking, daily/monthly spend limits, velocity alert thresholds, and gateway key quota limits.',
		highlights: ['CostUSD Calculation', 'Velocity Alerts', 'Key Spend Quotas'],
	},
	{
		id: 7,
		icon: RefreshCw,
		category: 'Operations',
		title: 'Production Operations & Migrator',
		tagline: 'Blue-Green & Auto Schema Recovery',
		description: 'Standalone schema migration with auto-dirty state recovery, separate /health and /ready probes for Blue-Green zero-downtime deployment.',
		highlights: ['Auto-Dirty Reset', 'Liveness & Readiness', 'Blue-Green Deployment'],
	},
	{
		id: 8,
		icon: KeyRound,
		category: 'Key Vault',
		title: 'AES-256-GCM Vault & OAuth Exchange',
		tagline: 'Dynamic Credential Allocation Pool',
		description: 'Encrypted key vault supporting Round Robin, LRU, and Fallback Cascade rotation strategies with Google OAuth token exchange.',
		highlights: ['AES-256-GCM Vault', 'Google OAuth Refresh', 'LRU & Round Robin'],
	},
];

const protocolPillars: Pillar[] = [
	{
		id: 9,
		icon: Plug,
		category: 'MCP Protocol',
		title: 'MCP Protocol Gateway',
		tagline: 'Model Context Protocol Integrator',
		description: 'Connect HTTP and SSE Model Context Protocol servers (GitHub, Notion, Custom Agents) with automatic JSON-RPC 2.0 discovery.',
		highlights: ['JSON-RPC 2.0 Discovery', 'GitHub & Notion MCP', 'SSE Pass-Through'],
	},
	{
		id: 10,
		icon: Wrench,
		category: 'Function Calling',
		title: 'Resource & Tool Gateway Control',
		tagline: 'Centralized Function Calling & SQL Engine',
		description: 'Register external REST API tools and parameterized PostgreSQL query templates with header injection, priority failover, and sandbox execution.',
		highlights: ['REST API Tool Hub', 'Parameterized SQL', 'Sandbox Testing'],
	},
	{
		id: 11,
		icon: FileCheck,
		category: 'Compliance',
		title: 'Cryptographic AI Audit Trail',
		tagline: 'SHA-256 Tamper-Proof Execution Log',
		description: '6-dimensional audit trail capturing WHO, REQUEST, MODEL, TOOLS/RESOURCES, COST, and OUTCOME with SHA-256 signature verification.',
		highlights: ['SHA-256 Signatures', '6D Telemetry Logging', 'Tamper-Proof Audit Vault'],
	},
];
---

<Layout title="RoozyLabs Prism - Universal AI Control Plane v0.3.0">
	<!-- Ambient Background Light (Static Subtle Prism Refraction) -->
	<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
		<div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[1200px] h-[500px] bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,rgba(139,92,246,0.12),transparent_70%)]"></div>
		<div class="absolute top-[800px] right-0 w-[500px] h-[500px] bg-[radial-gradient(circle_at_100%_50%,rgba(6,182,212,0.04),transparent_60%)]"></div>
	</div>

	<!-- Header Navigation -->
	<header class="sticky top-0 w-full z-50 bg-background/90 backdrop-blur-lg border-b border-border/80">
		<div class="h-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
			<!-- Brand Mark (Shield Mark) -->
			<div class="flex items-center gap-3">
				<a href="/" class="flex items-center gap-2.5 group">
					<div class="flex h-8 w-8 items-center justify-center rounded-md bg-[#7C3AED] text-white border border-violet-400/30 shadow-sm group-hover:bg-[#6D28D9] transition-colors">
						<Shield className="h-4 w-4" />
					</div>
					<div class="flex items-center gap-1.5">
						<span class="font-mono text-sm font-bold tracking-tight text-foreground">
							RoozyLabs <span class="text-primary">Prism</span>
						</span>
						<span class="hidden sm:inline-block font-mono text-[10px] text-muted-foreground bg-secondary/80 px-1.5 py-0.5 rounded border border-border">
							v0.3.0
						</span>
					</div>
				</a>
			</div>
			
			<!-- Desktop Nav Links -->
			<nav class="hidden md:flex items-center gap-6 lg:gap-8">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						rel={link.external ? "noopener noreferrer" : undefined}
						class="text-xs text-muted-foreground hover:text-foreground transition-colors font-medium flex items-center gap-1"
					>
						{link.label}
						{link.external && <ExternalLink className="h-3 w-3 opacity-60" />}
					</a>
				))}
			</nav>

			<!-- Action CTA & Mobile Nav Toggle -->
			<div class="flex items-center gap-3">
				<a 
					href="https://app.prism.roozylabs.com/signin" 
					class="hidden sm:inline-flex items-center justify-center h-8 px-3.5 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-md hover:bg-primary/90 transition-all shadow-sm"
				>
					Open Console
				</a>

				<!-- Mobile Navigation Toggle -->
				<button 
					id="mobile-menu-btn"
					type="button"
					aria-label="Toggle Navigation Menu"
					aria-expanded="false"
					class="md:hidden h-8 px-2.5 rounded-md border border-border bg-card flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring cursor-pointer"
				>
					<span id="menu-icon-open"><Menu className="h-4 w-4" /></span>
					<span id="menu-icon-close" class="hidden"><X className="h-4 w-4" /></span>
					<span class="font-mono text-[11px]">Menu</span>
				</button>
			</div>
		</div>

		<!-- Mobile Navigation Drawer -->
		<div id="mobile-menu" class="hidden md:hidden border-b border-border bg-card/95 backdrop-blur-lg px-6 py-4 shadow-xl">
			<div class="flex flex-col gap-2 font-medium text-xs">
				{navLinks.map((link) => (
					<a 
						href={link.href} 
						target={link.external ? "_blank" : "_self"}
						rel={link.external ? "noopener noreferrer" : undefined}
						class="py-2 text-muted-foreground hover:text-foreground transition-colors border-b border-border/50 last:border-0 flex items-center justify-between"
					>
						<span>{link.label}</span>
						{link.external && <ExternalLink className="h-3.5 w-3.5 opacity-60" />}
					</a>
				))}
				<a 
					href="https://app.prism.roozylabs.com/signin" 
					class="mt-3 w-full py-2.5 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-md text-center shadow-sm"
				>
					Open Console
				</a>
			</div>
		</div>
	</header>

	<!-- Main Content -->
	<main class="w-full flex-1 overflow-x-clip">
		<div class="flex flex-col w-full relative z-0">
			
			<!-- Hero Section -->
			<section class="w-full pt-12 sm:pt-20 pb-12 sm:pb-16 px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center text-center">
				<div class="max-w-5xl mx-auto flex flex-col items-center gap-5 sm:gap-6">
					
					<!-- System Status Pill -->
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border/80 bg-card/90 text-xs font-mono shadow-sm">
						<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
						<span class="text-muted-foreground text-[11px] font-medium">Control Plane v0.3.0 • Go 1.25 Engine</span>
					</div>

					<!-- Hero Headline -->
					<h1 class="font-bold text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] sm:leading-[1.08] tracking-tight text-foreground max-w-4xl">
						One Control Plane for Your Entire <span class="text-primary underline decoration-primary/30 underline-offset-8">AI Stack</span>
					</h1>

					<!-- Hero Subtitle -->
					<p class="text-sm sm:text-base md:text-lg text-muted-foreground max-w-2xl leading-relaxed px-2">
						Sub-2ms Gateway Engine, Multi-Tenant Row-Level Security, Deterministic Auto-Failover, and 5-Correlation Observability.
					</p>

					<!-- Action Buttons -->
					<div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto mt-2 px-4 sm:px-0">
						<a 
							href="https://app.prism.roozylabs.com/signin" 
							class="h-10 px-6 bg-primary text-primary-foreground font-mono text-xs font-semibold rounded-md hover:bg-primary/90 transition-all shadow-glow-primary flex items-center justify-center gap-2"
						>
							<span>Open Console</span>
							<ArrowRight className="h-3.5 w-3.5" />
						</a>
						<a 
							href="https://github.com/roozylabs/prism" 
							target="_blank" 
							rel="noopener noreferrer"
							class="h-10 px-6 bg-card text-foreground font-mono text-xs font-semibold rounded-md border border-border hover:bg-secondary/80 transition-colors flex items-center justify-center gap-2 shadow-sm"
						>
							<Github className="h-4 w-4" /> View Source on GitHub
						</a>
					</div>

					<!-- Interactive Code & SDK Switcher (Firecrawl Inspired Tabbed Console) -->
					<div id="quickstart-box" class="w-full max-w-3xl mt-8 rounded-xl border border-border/80 bg-console shadow-terminal-depth text-left font-mono text-xs overflow-hidden">
						<!-- Terminal Top Bar & Language Tabs -->
						<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-border/70 bg-console-header/90 px-3 py-2 gap-2">
							<!-- Tabs -->
							<div class="flex items-center gap-1 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0 scrollbar-none" id="code-tabs">
								<button 
									type="button" 
									data-tab="opencode" 
									class="code-tab-btn px-2.5 py-1 text-[11px] rounded bg-primary/20 text-primary border border-primary/30 font-semibold cursor-pointer transition-all"
								>
									OpenCode CLI
								</button>
								<button 
									type="button" 
									data-tab="claude" 
									class="code-tab-btn px-2.5 py-1 text-[11px] rounded text-muted-foreground hover:text-foreground hover:bg-secondary/50 font-medium cursor-pointer transition-all"
								>
									Claude Code
								</button>
								<button 
									type="button" 
									data-tab="python" 
									class="code-tab-btn px-2.5 py-1 text-[11px] rounded text-muted-foreground hover:text-foreground hover:bg-secondary/50 font-medium cursor-pointer transition-all"
								>
									Python
								</button>
								<button 
									type="button" 
									data-tab="node" 
									class="code-tab-btn px-2.5 py-1 text-[11px] rounded text-muted-foreground hover:text-foreground hover:bg-secondary/50 font-medium cursor-pointer transition-all"
								>
									Node.js
								</button>
								<button 
									type="button" 
									data-tab="curl" 
									class="code-tab-btn px-2.5 py-1 text-[11px] rounded text-muted-foreground hover:text-foreground hover:bg-secondary/50 font-medium cursor-pointer transition-all"
								>
									cURL
								</button>
							</div>

							<!-- Live Endpoint Indicator & Copy Button -->
							<div class="flex items-center justify-between sm:justify-end gap-3 w-full sm:w-auto">
								<span class="text-[10px] text-emerald-400 font-mono flex items-center gap-1 shrink-0">
									<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> api.prism.roozylabs.com
								</span>
								<button 
									id="copy-code-btn" 
									type="button"
									class="inline-flex items-center gap-1 px-2 py-0.5 rounded border border-border/80 bg-console-card hover:bg-secondary text-[10px] text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
								>
									<Copy className="h-3 w-3" id="copy-icon" />
									<span id="copy-label">Copy</span>
								</button>
							</div>
						</div>

						<!-- Code Snippet Display -->
						<div class="p-4 overflow-x-auto">
							<!-- OpenCode CLI Snippet -->
							<pre id="snippet-opencode" class="code-snippet block text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-slate-500">// ~/.config/opencode/opencode.jsonc</span>
<span class="text-purple-400">&#123;</span>
  <span class="text-cyan-400">"provider"</span>: <span class="text-emerald-400">"prism"</span>,
  <span class="text-cyan-400">"api_url"</span>: <span class="text-emerald-400">"https://api.prism.roozylabs.com"</span>,
  <span class="text-cyan-400">"api_key"</span>: <span class="text-emerald-400">"gw_sk_live_85061cbfc18e4ca58e0e..."</span>,
  <span class="text-cyan-400">"model"</span>: <span class="text-purple-400">"prism-auto"</span>, <span class="text-slate-500">// Smart router auto-selects optimal model</span>
  <span class="text-cyan-400">"extra_headers"</span>: <span class="text-purple-400">&#123;</span>
    <span class="text-cyan-400">"X-Request-ID"</span>: <span class="text-emerald-400">"req_uuid_v4"</span>,
    <span class="text-cyan-400">"X-Prism-Agent-ID"</span>: <span class="text-emerald-400">"opencode-agent-v2"</span>
  <span class="text-purple-400">&#125;</span>
<span class="text-purple-400">&#125;</span></code></pre>

							<!-- Claude Code Snippet -->
							<pre id="snippet-claude" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-slate-500"># Export environment variables for Claude Code CLI</span>
<span class="text-purple-400">export</span> <span class="text-cyan-400">ANTHROPIC_BASE_URL</span>=<span class="text-emerald-400">"https://api.prism.roozylabs.com"</span>
<span class="text-purple-400">export</span> <span class="text-cyan-400">ANTHROPIC_API_KEY</span>=<span class="text-emerald-400">"gw_sk_live_85061cbfc18e4ca58e0e..."</span>
<span class="text-purple-400">export</span> <span class="text-cyan-400">PRISM_ROUTING_POLICY</span>=<span class="text-emerald-400">"quality"</span>

<span class="text-slate-500"># Run Claude with automatic failover & quota monitoring</span>
claude</code></pre>

							<!-- Python SDK Snippet -->
							<pre id="snippet-python" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-purple-400">from</span> openai <span class="text-purple-400">import</span> OpenAI

client = OpenAI(
    base_url=<span class="text-emerald-400">"https://api.prism.roozylabs.com/v1"</span>,
    api_key=<span class="text-emerald-400">"gw_sk_live_85061cbfc18e4ca58e0e..."</span>,
    default_headers=&#123;<span class="text-cyan-400">"X-Prism-Agent-ID"</span>: <span class="text-emerald-400">"data-pipeline"</span>&#125;
)

response = client.chat.completions.create(
    model=<span class="text-emerald-400">"prism-auto"</span>,
    messages=[&#123;<span class="text-cyan-400">"role"</span>: <span class="text-emerald-400">"user"</span>, <span class="text-cyan-400">"content"</span>: <span class="text-emerald-400">"Analyze quarterly metrics."</span>&#125;]
)
print(response.choices[0].message.content)</code></pre>

							<!-- Node.js Snippet -->
							<pre id="snippet-node" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code><span class="text-purple-400">import</span> OpenAI <span class="text-purple-400">from</span> <span class="text-emerald-400">'openai'</span>;

<span class="text-purple-400">const</span> openai = <span class="text-purple-400">new</span> OpenAI(&#123;
  baseURL: <span class="text-emerald-400">'https://api.prism.roozylabs.com/v1'</span>,
  apiKey: <span class="text-emerald-400">'gw_sk_live_85061cbfc18e4ca58e0e...'</span>,
&#125;);

<span class="text-purple-400">const</span> response = <span class="text-purple-400">await</span> openai.chat.completions.create(&#123;
  model: <span class="text-emerald-400">'prism-auto'</span>,
  messages: [&#123; role: <span class="text-emerald-400">'user'</span>, content: <span class="text-emerald-400">'Generate deployment plan.'</span> &#125;],
&#125;);
console.log(response.choices[0].message.content);</code></pre>

							<!-- cURL Snippet -->
							<pre id="snippet-curl" class="code-snippet hidden text-slate-300 leading-relaxed min-w-[280px]"><code>curl -X POST https://api.prism.roozylabs.com/v1/chat/completions \
  -H <span class="text-emerald-400">"Authorization: Bearer gw_sk_live_85061cbfc18e4ca58e0e..."</span> \
  -H <span class="text-emerald-400">"Content-Type: application/json"</span> \
  -H <span class="text-emerald-400">"X-Request-ID: $(uuidgen)"</span> \
  -d <span class="text-emerald-400">'&#123;
    "model": "prism-auto",
    "messages": [&#123;"role": "user", "content": "Hello from cURL"&#125;]
  &#125;'</span></code></pre>
						</div>
					</div>
				</div>
			</section>

			<!-- Performance Benchmark & SLA Stats Ribbon -->
			<section class="w-full py-8 sm:py-10 px-4 sm:px-6 lg:px-8 bg-card/60 border-y border-border/80">
				<div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
					{benchmarkStats.map((stat) => (
						<div class="p-5 bg-background/90 border border-border/80 rounded-lg shadow-sm flex flex-col items-center text-center relative overflow-hidden group hover:border-primary/50 transition-colors">
							<div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-primary/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
							<span class="font-mono font-bold text-2xl sm:text-3xl text-primary">{stat.value}</span>
							<span class="font-semibold text-xs sm:text-sm text-foreground mt-1.5">{stat.label}</span>
							<span class="font-mono text-[11px] text-muted-foreground mt-1">{stat.desc}</span>
						</div>
					))}
				</div>
			</section>

			<!-- Compatible AI Tool Ecosystem Ribbon -->
			<section class="w-full py-12 px-4 sm:px-6 lg:px-8 bg-background border-b border-border/80">
				<div class="max-w-7xl mx-auto flex flex-col items-center gap-6">
					<div class="text-center">
						<span class="font-mono text-xs text-primary uppercase tracking-wider font-semibold">Integrations</span>
						<h2 class="text-xl sm:text-2xl font-bold text-foreground mt-1">Compatible AI Clients</h2>
					</div>
					
					<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5 w-full">
						{clientEcosystem.map((client) => {
							const IconComponent = client.icon;
							return (
								<div class="flex items-center gap-3 p-3.5 bg-card/70 border border-border/80 rounded-lg hover:border-primary/50 transition-colors shadow-sm">
									<div class="w-8 h-8 rounded-md bg-primary/10 border border-primary/20 flex items-center justify-center text-primary shrink-0">
										<IconComponent className="h-4 w-4" />
									</div>
									<div class="min-w-0">
										<div class="font-semibold text-xs text-foreground truncate">{client.name}</div>
										<div class="text-[11px] text-muted-foreground truncate">{client.type}</div>
									</div>
								</div>
