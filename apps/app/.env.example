# Prism Dashboard Environment Configuration

# Backend API URL (Default for local development is http://localhost:8080, in Docker use http://api:8080)
API_URL=http://localhost:8080

# Cloudflare Turnstile Public Site Key (Default '1x00000000000000000000AA' is Cloudflare's always-pass testing key)
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=1x00000000000000000000AA
