	<!-- Client-side Interactive Scripts (No Framework Dependency) -->
	<script>
		// 1. Mobile Navigation Toggle
		const menuBtn = document.getElementById('mobile-menu-btn');
		const mobileMenu = document.getElementById('mobile-menu');
		const menuIconOpen = document.getElementById('menu-icon-open');
		const menuIconClose = document.getElementById('menu-icon-close');

		if (menuBtn && mobileMenu && menuIconOpen && menuIconClose) {
			menuBtn.addEventListener('click', () => {
				const isHidden = mobileMenu.classList.contains('hidden');
				if (isHidden) {
					mobileMenu.classList.remove('hidden');
					menuIconOpen.classList.add('hidden');
					menuIconClose.classList.remove('hidden');
					menuBtn.setAttribute('aria-expanded', 'true');
				} else {
					mobileMenu.classList.add('hidden');
					menuIconOpen.classList.remove('hidden');
					menuIconClose.classList.add('hidden');
					menuBtn.setAttribute('aria-expanded', 'false');
				}
			});

			const links = mobileMenu.querySelectorAll('a');
			links.forEach((link) => {
				link.addEventListener('click', () => {
					mobileMenu.classList.add('hidden');
					menuIconOpen.classList.remove('hidden');
					menuIconClose.classList.add('hidden');
					menuBtn.setAttribute('aria-expanded', 'false');
				});
			});
		}

		// 2. Interactive Code Tabs Switcher
		const tabButtons = document.querySelectorAll('.code-tab-btn');
		const snippets = document.querySelectorAll('.code-snippet');

		tabButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const targetTab = button.getAttribute('data-tab');

				tabButtons.forEach((btn) => {
					btn.classList.remove('bg-primary/20', 'text-primary', 'border-primary/30', 'font-semibold');
					btn.classList.add('text-muted-foreground', 'font-medium');
				});
				button.classList.remove('text-muted-foreground', 'font-medium');
				button.classList.add('bg-primary/20', 'text-primary', 'border-primary/30', 'font-semibold');

				snippets.forEach((snippet) => {
					snippet.classList.add('hidden');
					snippet.classList.remove('block');
				});
				const activeSnippet = document.getElementById(`snippet-${targetTab}`);
				if (activeSnippet) {
					activeSnippet.classList.remove('hidden');
					activeSnippet.classList.add('block');
				}
			});
		});

		// 3. Snippet Copy to Clipboard Button
		const copyBtn = document.getElementById('copy-code-btn');
		const copyLabel = document.getElementById('copy-label');

		if (copyBtn && copyLabel) {
			copyBtn.addEventListener('click', async () => {
				const visibleSnippet = document.querySelector('.code-snippet.block') || document.querySelector('.code-snippet:not(.hidden)');
				if (visibleSnippet) {
					const codeText = visibleSnippet.textContent || '';
					try {
						await navigator.clipboard.writeText(codeText);
						copyLabel.textContent = 'Copied!';
						copyBtn.classList.add('text-emerald-400', 'border-emerald-500/40');
						setTimeout(() => {
							copyLabel.textContent = 'Copy';
							copyBtn.classList.remove('text-emerald-400', 'border-emerald-500/40');
						}, 2000);
					} catch (e) {
						console.error('Failed to copy', e);
					}
				}
			});
		}

		// 4. Interactive Policy Simulator
		const policyButtons = document.querySelectorAll('.policy-btn');
		const routeModel = document.getElementById('route-model');
		const routeCost = document.getElementById('route-cost');
		const routeLatency = document.getElementById('route-latency');
		const routeExp = document.getElementById('route-explanation');

		const policyData = {
			balanced: {
				model: 'GPT-4o-mini',
				cost: '$0.000063',
				latency: '~195 ms',
				exp: 'Task classified as low complexity summarization. Balanced policy selected GPT-4o-mini for maximum speed and 90% cost savings over flagship models.'
			},
			cheap: {
				model: 'Claude 3.5 Haiku',
				cost: '$0.000042',
				latency: '~165 ms',
				exp: 'Lowest Cost policy selected Claude 3.5 Haiku ($0.25/1M input tokens). Saves $0.0012 per invocation while maintaining 100% summary accuracy.'
			},
			quality: {
				model: 'Claude 3.7 Sonnet',
				cost: '$0.001260',
				latency: '~420 ms',
				exp: 'Maximum Quality policy routes directly to Claude 3.7 Sonnet for maximum nuance and complex multi-step reasoning capabilities.'
			}
		};

		policyButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const policy = btn.getAttribute('data-policy') || 'balanced';

				policyButtons.forEach((b) => {
					b.classList.remove('bg-primary/20', 'text-primary', 'border-primary/40', 'font-semibold');
					b.classList.add('bg-background', 'text-muted-foreground', 'border-border', 'font-medium');
				});
				btn.classList.remove('bg-background', 'text-muted-foreground', 'border-border', 'font-medium');
				btn.classList.add('bg-primary/20', 'text-primary', 'border-primary/40', 'font-semibold');

				if (routeModel && routeCost && routeLatency && routeExp && policyData[policy]) {
					const data = policyData[policy];
					routeModel.textContent = data.model;
					routeCost.textContent = data.cost;
					routeLatency.textContent = data.latency;
					routeExp.textContent = data.exp;
				}
			});
		});
	</script>
